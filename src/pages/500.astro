---
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import TreeseedAppLayout from '../layouts/AppLayout.astro';
import TreeseedPublicLayout from '../layouts/PublicLayout.astro';
import { loadAppContext } from '../view-models/app-access.js';

Astro.response.status = 500;
const authenticatedAppPath = Boolean(Astro.locals.auth?.principal && Astro.url.pathname.startsWith('/app'));
const context = authenticatedAppPath ? await loadAppContext(Astro).catch(() => null) : null;
const title = 'TreeSeed could not render this page';
const description = 'The request failed before a trustworthy page state could be shown. No empty data has been inferred.';
---

{authenticatedAppPath && context ? (
	<TreeseedAppLayout title={title} description={description} currentPath={Astro.url.pathname} teams={context.teams} activeTeam={context.activeTeam} contentOwnsPageHeader>
		<section class="ts-template" aria-label="Page unavailable" data-scene="admin.error">
			<PageHeader eyebrow="Unavailable" title={title} description={description} />
			<Panel title="Try the request again" description="If the problem continues, return to Admin start without changing your current team or session.">
				<div class="ts-action-bar"><Button href={Astro.url.pathname + Astro.url.search} variant="primary" reload>Retry</Button><Button href="/app/" variant="secondary">Admin start</Button></div>
			</Panel>
		</section>
	</TreeseedAppLayout>
) : (
	<TreeseedPublicLayout title={`${title} | TreeSeed`} description={description} currentPath={Astro.url.pathname}>
		<main class="ts-template" aria-label="Page unavailable" data-scene="public.error">
			<PageHeader eyebrow="Unavailable" title={title} description={description} />
			<Panel title="Try again" description="The public site remains available from its home page.">
				<div class="ts-action-bar"><Button href={Astro.url.pathname + Astro.url.search} variant="primary" reload>Retry</Button><Button href="/" variant="secondary">Go home</Button></div>
			</Panel>
		</main>
	</TreeseedPublicLayout>
)}
