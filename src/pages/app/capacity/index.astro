---
import CapacityWorkspace from '@treeseed/ui/components/astro/capacity/CapacityWorkspace.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { items, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { loadCommandSnapshot } from '../../../view-models/command/command-state.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro); const team = context.activeTeam; const base = team ? `/v1/teams/${encodeURIComponent(team.id)}/capacity` : '';
const [snapshot, access, preferences, registrationKey, requestPage, membershipPage] = await Promise.all([
	team ? loadCommandSnapshot(api, team.id) : null,
	team ? api.getTeamAccessSummary(team.id).catch(() => null) : null,
	api.accountPreferences().catch(() => ({ timeZone: 'UTC' })),
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-registration-key`).catch(() => null) : null,
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-requests?limit=100`).catch(() => null) : null,
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-memberships?limit=100`).catch(() => null) : null,
]);
const usagePages = team && snapshot ? await Promise.all(snapshot.projects.map((project) => api.request('GET', `${base}/usage?projectId=${encodeURIComponent(String(project.id))}&limit=100`).catch(() => null))) : [];
const providerStatuses = team && snapshot ? await Promise.all(snapshot.providers.map((provider: any) => {
	const providerId=String(provider.providerId ?? provider.id ?? '');
	return providerId?api.request('GET',`/v1/teams/${encodeURIComponent(team.id)}/capacity-providers/${encodeURIComponent(providerId)}/status`).catch(()=>null):null;
})) : [];
const reservationItems = snapshot?.reservations ?? []; const usageItems = usagePages.flatMap(items); const ledgerItems = snapshot?.ledger ?? [];
const canManage = Boolean((access?.roles ?? access?.access?.roles ?? []).some((role: string) => ['team_owner', 'project_lead'].includes(role))); const csrfToken = ensureCsrfToken(Astro);
const providerRequests = items(requestPage); const memberships = items(membershipPage);
const providerAlerts=providerStatuses.flatMap((status:any)=>Array.isArray(status?.alerts)?status.alerts:[]);
const object = (value: unknown) => value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, any> : {};
const number = (...values: unknown[]) => values.map(Number).find(Number.isFinite) ?? 0;
const fleet = (snapshot?.providers ?? []).map((provider: any) => {
	const native = object(provider.nativeCapacity ?? provider.capacity ?? provider.supply); const budget = object(provider.budget ?? native.budget);
	const membership = memberships.find((entry: any) => String(entry.providerId) === String(provider.providerId));
	const concurrency = number(native.maxConcurrentRunners, provider.maxConcurrentRunners, object(membership?.supplyOffer).maxConcurrentRunners, 1);
	return { id: String(provider.providerId ?? provider.id), name: text(provider.providerName, provider.displayName, provider.providerId, 'Capacity provider'),
		providerClass: String(object(provider.metadata).providerClass ?? object(membership?.metadata).providerClass ?? 'agent'), status: String(provider.status ?? 'unknown'),
		owner: object(membership?.metadata).ownerType === 'team' ? 'team owned' : 'approved provider', assignments: number(provider.activeAssignmentCount),
		capabilities: Array.isArray(provider.capabilitySummary) ? provider.capabilitySummary.map(String) : Array.isArray(provider.capabilities) ? provider.capabilities.map(String) : [],
		updatedAt: provider.updatedAt ?? provider.lastHeartbeatAt ?? null,
		meters: [
			{ label: 'Runner lanes', used: number(provider.activeAssignmentCount), reserved: number(provider.reservedAssignmentCount), total: concurrency, unit: '' },
			...(number(budget.inputTokens, native.inputTokens) ? [{ label: 'Input tokens', used: number(provider.usedInputTokens), reserved: number(provider.reservedInputTokens), total: number(budget.inputTokens, native.inputTokens), tone: 'violet' as const }] : []),
			...(number(budget.usd, native.usd) ? [{ label: 'Cost', used: number(provider.usedUsd), reserved: number(provider.reservedUsd), total: number(budget.usd, native.usd), unit: ' USD', tone: 'amber' as const }] : []),
		],
	};
});
---
<TreeseedAppLayout title="Command capacity" description="Provider availability, allocation, reservations, usage, routing, and settlement." currentPath="/app/command" teams={context.teams} activeTeam={team} contentOwnsPageHeader>
	<CapacityWorkspace teamId={team?.id} timeZone={preferences.timeZone} fleet={fleet} providers={snapshot?.providers ?? []} {providerAlerts} {providerRequests} {memberships} reservations={reservationItems} usageCount={usageItems.length} ledgerCount={ledgerItems.length} registrationKey={object(registrationKey)} {canManage} {csrfToken} />
</TreeseedAppLayout>
