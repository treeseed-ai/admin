---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import CapacityControlRoom from '@treeseed/ui/components/astro/capacity/CapacityControlRoom.astro';
import MetricCard from '@treeseed/ui/components/astro/data/metrics/MetricCard.astro';
import MetricGrid from '@treeseed/ui/components/astro/data/metrics/MetricGrid.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ResourceCard from '@treeseed/ui/components/astro/surface/ResourceCard.astro';
import ModeNavigation from '../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { items, statusTone, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { loadCommandSnapshot } from '../../../view-models/command/command-state.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro); const team = context.activeTeam; const base = team ? `/v1/teams/${encodeURIComponent(team.id)}/capacity` : '';
const [snapshot, access, preferences, registrationKey, requestPage, membershipPage] = await Promise.all([
	team ? loadCommandSnapshot(api, team.id) : null,
	team ? api.getTeamAccessSummary(team.id).catch(() => null) : null,
	api.accountPreferences().catch(() => ({ timeZone: 'UTC' })),
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-registration-key`).catch(() => null) : null,
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-requests?limit=100`).catch(() => null) : null,
	team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-memberships?limit=100`).catch(() => null) : null,
]);
const usagePages = team && snapshot ? await Promise.all(snapshot.projects.map((project) => api.request('GET', `${base}/usage?projectId=${encodeURIComponent(String(project.id))}&limit=100`).catch(() => null))) : [];
const reservationItems = snapshot?.reservations ?? []; const usageItems = usagePages.flatMap(items); const ledgerItems = snapshot?.ledger ?? [];
const canManage = Boolean((access?.roles ?? access?.access?.roles ?? []).some((role: string) => ['team_owner', 'project_lead'].includes(role))); const csrfToken = ensureCsrfToken(Astro);
const providerRequests = items(requestPage); const memberships = items(membershipPage);
const object = (value: unknown) => value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, any> : {};
const number = (...values: unknown[]) => values.map(Number).find(Number.isFinite) ?? 0;
const fleet = (snapshot?.providers ?? []).map((provider: any) => {
	const native = object(provider.nativeCapacity ?? provider.capacity ?? provider.supply); const budget = object(provider.budget ?? native.budget);
	const membership = memberships.find((entry: any) => String(entry.providerId) === String(provider.providerId));
	const concurrency = number(native.maxConcurrentRunners, provider.maxConcurrentRunners, object(membership?.supplyOffer).maxConcurrentRunners, 1);
	return { id: String(provider.providerId ?? provider.id), name: text(provider.providerName, provider.displayName, provider.providerId, 'Capacity provider'),
		providerClass: String(object(provider.metadata).providerClass ?? object(membership?.metadata).providerClass ?? 'agent'), status: String(provider.status ?? 'unknown'),
		owner: object(membership?.metadata).ownerType === 'team' ? 'team owned' : 'approved provider', assignments: number(provider.activeAssignmentCount),
		capabilities: Array.isArray(provider.capabilitySummary) ? provider.capabilitySummary.map(String) : Array.isArray(provider.capabilities) ? provider.capabilities.map(String) : [],
		updatedAt: provider.updatedAt ?? provider.lastHeartbeatAt ?? null,
		meters: [
			{ label: 'Runner lanes', used: number(provider.activeAssignmentCount), reserved: number(provider.reservedAssignmentCount), total: concurrency, unit: '' },
			...(number(budget.inputTokens, native.inputTokens) ? [{ label: 'Input tokens', used: number(provider.usedInputTokens), reserved: number(provider.reservedInputTokens), total: number(budget.inputTokens, native.inputTokens), tone: 'violet' as const }] : []),
			...(number(budget.usd, native.usd) ? [{ label: 'Cost', used: number(provider.usedUsd), reserved: number(provider.reservedUsd), total: number(budget.usd, native.usd), unit: ' USD', tone: 'amber' as const }] : []),
		],
	};
});
const registrationBase = `/v1/teams/${encodeURIComponent(team?.id ?? '')}/capacity-registration-key`;
---
<TreeseedAppLayout title="Command capacity" description="Provider availability, allocation, reservations, usage, routing, and settlement." currentPath="/app/command" teams={context.teams} activeTeam={team} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Capacity operations" data-scene="command.capacity"><PageHeader eyebrow="Command · Capacity" title="Capacity and routing" description="Understand supply, commitments, actual usage, and pressure without supervising provider internals."><Button slot="actions" href="/app/command" variant="secondary">Command overview</Button></PageHeader><ModeNavigation mode="command" current="capacity" />
		{!team ? <EmptyState title="Choose an active team" description="Capacity evidence is team-scoped." /> : <>
			<CapacityControlRoom providers={fleet} timeZone={preferences.timeZone} title="Provider energy grid" description="Strict intersections of provider supply, team grants, reservations, and live usage." />
			<MetricGrid min="12rem"><MetricCard label="Provider sessions" value={snapshot?.providers.length ?? 0} description="Availability reports" /><MetricCard label="Reservations" value={reservationItems.length} description="Committed capacity" /><MetricCard label="Usage records" value={usageItems.length} description="Reported actuals" /><MetricCard label="Ledger entries" value={ledgerItems.length} description="Settled accounting evidence" /></MetricGrid>
			<div class="ts-resource-grid">
				<Panel eyebrow="Connection authority" title="Provider invite circuit" description="Invite authority is team-scoped. Values remain concealed until an explicit audited reveal.">
					<ResourceCard title="Team invite token" description={text(object(registrationKey).status, 'Not initialized')} status={String(object(registrationKey).status ?? 'unknown')} tone={statusTone(object(registrationKey).status)} />
					{canManage ? <div class="ts-button-row">{['rotate','enable','disable'].map((action) => <form method="post" action={`${registrationBase}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} the team capacity invite token?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`capacity-key:${action}:${object(registrationKey).generation ?? 'current'}`} /><Button type="submit" variant={action === 'disable' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}
					<p class="ts-help-text">Secret reveal is intentionally excluded from page hydration and logs. Use the audited reveal action after step-up authentication.</p>
				</Panel>
				<Panel eyebrow="Intake" title={`${providerRequests.length} provider requests`} description="Approve identities only after reviewing the signed capability and supply offer.">
					{providerRequests.map((request: any) => <div class="ts-capacity-request"><ResourceCard title={text(request.displayName, request.providerId, 'Provider request')} description={text(request.capabilitySummary, request.status)} status={String(request.status ?? 'pending')} tone={statusTone(request.status)} />{canManage && String(request.status) === 'pending' ? <div class="ts-button-row">{['approve','reject'].map((action) => <form method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-requests/${encodeURIComponent(String(request.id))}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} this capacity provider?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${request.id}:${action}:${request.updatedAt ?? 'current'}`} />{action === 'reject' ? <input class="ts-control" name="reason" aria-label="Rejection reason" required placeholder="Reason" /> : null}<Button type="submit" variant={action === 'reject' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}</div>)}
					{!providerRequests.length ? <p>No registration requests are waiting.</p> : null}
				</Panel>
			</div>
			<Panel eyebrow="Fleet governance" title={`${memberships.length} approved provider memberships`} description="Teams control approval, grants, suspension, and revocation. Private host settings remain provider-owned.">
				<div class="ts-capacity-memberships">{memberships.map((membership: any) => <article><div><strong>{text(membership.teamAlias, membership.displayName, membership.providerId)}</strong><code>{String(membership.id)}</code><span>{String(membership.status)}</span></div>{canManage ? <div class="ts-button-row">{(String(membership.status) === 'suspended' ? ['resume','revoke'] : ['suspend','revoke']).map((action) => <form method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/capacity-provider-memberships/${encodeURIComponent(String(membership.id))}/${action}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${action} this provider membership?`} data-ts-refresh-target='[data-scene="command.capacity"]'><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${membership.id}:${action}:${membership.updatedAt ?? 'current'}`} /><Button type="submit" variant={action === 'revoke' ? 'danger' : 'secondary'} size="sm">{action}</Button></form>)}</div> : null}</article>)}</div>
			</Panel>
			<div class="ts-resource-grid"><Panel eyebrow="Supply" title="Provider availability" description="Capacity providers report native budgets, concurrency, windows, and capabilities.">{snapshot?.providers.map((provider) => <ResourceCard title={text(provider.providerName, provider.providerId, 'Capacity provider')} description={text(provider.capabilitySummary, provider.lifecycleReason, 'Availability session')} status={String(provider.status ?? 'unknown')} tone={statusTone(provider.status)} />)}{!snapshot?.providers.length ? <p>No provider sessions were returned.</p> : null}</Panel><Panel eyebrow="Demand" title="Reservations and pressure" description="Open an assignment for routing evidence or review an overrun through its existing authorized action.">{reservationItems.map((reservation) => <div><ResourceCard title={text(reservation.projectName, reservation.projectId, 'Capacity reservation')} description={text(reservation.reason, reservation.status, 'Reserved capacity')} status={String(reservation.overrunStatus ?? reservation.status ?? 'reserved')} tone={statusTone(reservation.overrunStatus ?? reservation.status)} href={reservation.assignmentId ? `/app/command/assignments/${encodeURIComponent(String(reservation.assignmentId))}` : undefined} />{canManage && ['requested', 'pending'].includes(String(reservation.overrunStatus ?? reservation.overrun_status ?? '')) ? <div class="ts-button-row">{['approve', 'reject'].map((decision) => <form method="post" action={`${base}/reservations/${encodeURIComponent(String(reservation.id))}/overrun/${decision}`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm={`${decision === 'approve' ? 'Approve' : 'Reject'} this overrun request?`} data-ts-refresh-target='[data-scene="command.capacity"]' data-ts-success-message={`Overrun ${decision === 'approve' ? 'approved and available to scheduling' : 'rejected; dependent work remains constrained'}.`}><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="idempotencyKey" value={`${reservation.id}:${decision}:${reservation.updatedAt ?? reservation.createdAt ?? 'current'}`} /><label class="ts-field"><span class="ts-field__label">Reason</span><input class="ts-control" name="reason" required /></label><Button type="submit" variant={decision === 'reject' ? 'danger' : 'secondary'}>{decision === 'approve' ? 'Approve overrun' : 'Reject overrun'}</Button></form>)}</div> : null}</div>)}{!reservationItems.length ? <p>No reservation evidence was returned.</p> : null}</Panel></div>
			<Panel eyebrow="Accounting" title="Usage and ledger" description="Actuals and settlement remain durable API control-plane records, not reconciled infrastructure."><p>{usageItems.length} usage records and {ledgerItems.length} ledger entries are visible in the current bounded snapshot.</p></Panel>
		</>}
	</section>
</TreeseedAppLayout>
<style>
	.ts-capacity-request{display:grid;gap:.6rem;padding-block:.65rem;border-bottom:1px solid var(--sl-color-gray-5)}.ts-help-text{color:var(--sl-color-gray-3);font-size:.78rem}.ts-capacity-memberships{display:grid;gap:.65rem}.ts-capacity-memberships article{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem;border:1px solid var(--sl-color-gray-5);background:color-mix(in srgb,var(--sl-color-black) 12%,transparent)}.ts-capacity-memberships article>div:first-child{display:grid;gap:.2rem}.ts-capacity-memberships code{font-size:.65rem;color:var(--sl-color-gray-3)}.ts-capacity-memberships span{font:700 .62rem var(--ts-font-mono,monospace);text-transform:uppercase;color:var(--sl-color-accent)}@media(max-width:42rem){.ts-capacity-memberships article{align-items:stretch;flex-direction:column}}
</style>
