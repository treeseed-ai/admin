---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import ResourceCard from '@treeseed/ui/components/astro/surface/ResourceCard.astro';
import ModeNavigation from '../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { dateValue, statusTone, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { loadFocusSnapshot } from '../../../view-models/focus/focus-state.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const [snapshot, preferences] = await Promise.all([context.activeTeam ? loadFocusSnapshot(api, context.activeTeam.id) : null, api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))]);
---
<TreeseedAppLayout title="Focus decisions" description="The durable record of authorized organizational choices." currentPath="/app/focus" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Decision record" data-scene="focus.decisions">
		<PageHeader eyebrow="Focus · Decisions" title="Decision record" description="Inspect why a choice was made, whether planning is ready, and what execution may now proceed."><Button slot="actions" href="/app/command">View operational impact</Button></PageHeader>
		<ModeNavigation mode="focus" current="decisions" />
		{!context.activeTeam ? <EmptyState title="Choose an active team" description="Decisions are team-scoped." /> : !snapshot?.decisions.length ? <EmptyState title="No decisions in this snapshot" description="Accepted or rejected governance outcomes will appear here." /> : <div class="ts-resource-grid">
			{snapshot.decisions.map((decision) => <div><ResourceCard title={text(decision.title, decision.proposalTitle, 'Recorded decision')} description={`${text(decision.reason, decision.summary, 'No rationale supplied.')} · ${decision.capacityPlanId || decision.capacity_plan_id ? 'Capacity plan linked' : 'Capacity plan not linked'}`} status={String(decision.status ?? decision.outcome ?? 'recorded')} tone={statusTone(decision.status ?? decision.outcome)} href={decision.proposalId ? `/app/focus/proposals/${encodeURIComponent(String(decision.proposalId))}` : undefined} />{dateValue(decision.decidedAt, decision.createdAt) ? <p>Recorded <Timestamp value={dateValue(decision.decidedAt, decision.createdAt)!} timeZone={preferences.timeZone} /></p> : null}</div>)}
		</div>}
	</section>
</TreeseedAppLayout>
