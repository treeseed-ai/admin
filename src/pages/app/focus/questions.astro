---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ModeNavigation from '../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { dateValue, record, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { loadFocusSnapshot } from '../../../view-models/focus/focus-state.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const [snapshot, preferences] = await Promise.all([context.activeTeam ? loadFocusSnapshot(api, context.activeTeam.id) : null, api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))]);
const commonsTeamId = text(record(snapshot?.summary.team).id); const access = commonsTeamId ? await api.getTeamAccessSummary(commonsTeamId).catch(() => null) : null;
const canSteward = Boolean((api.currentPrincipal?.roles ?? []).some((role: string) => ['seed_admin', 'platform_admin'].includes(role)) || (access?.roles ?? access?.access?.roles ?? []).some((role: string) => ['team_owner', 'project_lead'].includes(role)));
const selected = Astro.url.searchParams.get('question'); const csrfToken = ensureCsrfToken(Astro);
const questions = [...(snapshot?.questions ?? [])].sort((a, b) => String(b.updatedAt ?? b.createdAt).localeCompare(String(a.updatedAt ?? a.createdAt)));
---
<TreeseedAppLayout title="Focus questions" description="A quiet queue for evidence and uncertainty." currentPath="/app/focus" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Focus questions" data-scene="focus.questions">
		<PageHeader eyebrow="Focus · Questions" title="Resolve uncertainty" description="Each answer remains connected to its evidence, policy, and affected work."><Button slot="actions" href="/app/command" variant="secondary">Return to Command</Button></PageHeader>
		<ModeNavigation mode="focus" current="questions" />
		{!context.activeTeam ? <EmptyState title="Choose an active team" description="Questions are team-scoped." /> : !questions.length ? <EmptyState title="No questions in this snapshot" description="New inquiries will appear here without automatic refresh." /> : <div class="ts-resource-grid">
			{questions.map((question) => <Panel eyebrow={String(question.status ?? 'open')} title={text(question.title, question.question, 'Untitled question')} description={text(question.summary, question.description, 'No context supplied.')}>
				<p><strong>Evidence policy:</strong> {text(question.answerPolicy, question.answer_policy, 'Use attributable evidence and state remaining uncertainty.')}</p>
				<p><strong>Affected work:</strong> {text(question.projectId, question.objectiveId, 'No affected work recorded.')}</p>
				{dateValue(question.updatedAt, question.createdAt) ? <p>Evidence state at <Timestamp value={dateValue(question.updatedAt, question.createdAt)!} timeZone={preferences.timeZone} /></p> : null}
				{canSteward && (selected === String(question.id) || !['answered', 'closed'].includes(String(question.status))) ? <form class="ts-form-stack" method="post" action={`/v1/commons/questions/${encodeURIComponent(String(question.id))}/answer`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-refresh-target='[data-scene="focus.questions"]' data-ts-success-message="Answer recorded and linked to the inquiry.">
					<input type="hidden" name="csrfToken" value={csrfToken} /><label class="ts-field"><span class="ts-field__label">Evidence-backed answer</span><textarea class="ts-control" name="answer" required rows="5"></textarea></label><Button type="submit">Record answer</Button>
				</form> : null}
			</Panel>)}
		</div>}
	</section>
</TreeseedAppLayout>
