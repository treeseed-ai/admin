---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import CommonsProposalCard from '@treeseed/ui/components/astro/governance/CommonsProposalCard.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ModeNavigation from '../../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../../lib/market/api-client.ts';
import { loadAppContext } from '../../../../view-models/app-access.ts';
import { loadFocusSnapshot } from '../../../../view-models/focus/focus-state.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const snapshot = context.activeTeam ? await loadFocusSnapshot(api, context.activeTeam.id) : null; const csrfToken = ensureCsrfToken(Astro);
const stages = ['draft', 'review', 'voting', 'decided'];
const stageFor = (status: unknown) => ['approved', 'rejected', 'implemented', 'decided'].includes(String(status)) ? 'decided' : ['under_review', 'review'].includes(String(status)) ? 'review' : String(status) === 'voting' ? 'voting' : 'draft';
---
<TreeseedAppLayout title="Focus proposals" description="Move proposals from rationale to authorized decision." currentPath="/app/focus" teams={context.teams} activeTeam={context.activeTeam} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Focus proposals" data-scene="focus.proposals">
		<PageHeader eyebrow="Focus · Proposals" title="Proposal pipeline" description="Draft, inspect, challenge, and decide with provenance intact."><Button slot="actions" href="/app/command" variant="secondary">Return to Command</Button></PageHeader>
		<ModeNavigation mode="focus" current="proposals" />
		{!context.activeTeam ? <EmptyState title="Choose an active team" description="Proposals are team-scoped." /> : <>
			<Panel eyebrow="New proposal" title="Frame a consequential change" description="Capture the intended outcome and rationale before governance begins.">
				<form class="ts-form-stack" method="post" action="/v1/commons/proposals" data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-reset-on-success="true" data-ts-refresh-target='[data-scene="focus.proposals"]' data-ts-success-message="Proposal created in draft state.">
					<input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="teamId" value={context.activeTeam.id} /><input type="hidden" name="scope" value="treeseed_commons" /><input type="hidden" name="decisionType" value="advisory" />
					<label class="ts-field"><span class="ts-field__label">Title</span><input class="ts-control" name="title" required /></label><label class="ts-field"><span class="ts-field__label">Summary</span><textarea class="ts-control" name="summary" required rows="3"></textarea></label><label class="ts-field"><span class="ts-field__label">Rationale and expected consequences</span><textarea class="ts-control" name="body" required rows="6"></textarea></label><Button type="submit">Create proposal</Button>
				</form>
			</Panel>
			<div class="ts-resource-grid">{stages.map((stage) => <Panel eyebrow="Governance stage" title={stage[0].toUpperCase() + stage.slice(1)} description={`Proposals currently in ${stage}.`}>
				{snapshot?.proposals.filter((item) => stageFor(item.status) === stage).map((proposal) => <CommonsProposalCard proposal={proposal as any} href={`/app/focus/proposals/${encodeURIComponent(String(proposal.id))}`} />)}
				{!snapshot?.proposals.some((item) => stageFor(item.status) === stage) ? <p>No proposals in this stage.</p> : null}
			</Panel>)}</div>
		</>}
	</section>
</TreeseedAppLayout>
