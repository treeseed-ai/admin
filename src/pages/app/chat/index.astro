---
import CoreWorkspaceNavigation from '@treeseed/ui/components/astro/navigation/CoreWorkspaceNavigation.astro';
import TeamChatWorkspace from '@treeseed/ui/components/astro/discussion/TeamChatWorkspace.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { items } from '../../../lib/operations/records';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const app = await loadAppContext(Astro);
const api = new ApiClientFacade(Astro);
const projects = app.activeTeam ? items(await api.listTeamProjects(app.activeTeam.id).catch(() => [])) : [];
const requestedProject = Astro.url.searchParams.get('project');
const activeProject = projects.find((project: any) => String(project.id) === requestedProject || project.slug === requestedProject) ?? projects[0] ?? null;
const principal = api.currentPrincipal;
const context = app.activeTeam && principal ? {
	teamId: app.activeTeam.id,
	projectId: activeProject ? String(activeProject.id) : undefined,
	identityLabel: principal.displayName ?? 'Current account',
	endpoint: '/v1/discussions',
	initialTopic: activeProject ? `${activeProject.displayName ?? activeProject.name ?? activeProject.slug} discussion` : 'New team discussion',
	realtime: { endpoint: '/v1/session/events', enabled: true },
} : null;
---

<TreeseedAppLayout title="Chat" description="Durable team and agent correspondence." currentPath="/app/chat" teams={app.teams} activeTeam={app.activeTeam} contentOwnsPageHeader>
	<CoreWorkspaceNavigation current="chat" />
	<TeamChatWorkspace {context} projects={projects.map((project: any) => ({ id: String(project.id), label: project.displayName ?? project.name ?? project.slug }))} activeProjectId={activeProject ? String(activeProject.id) : undefined} />
</TreeseedAppLayout>
