---
import { SERVICE_PROVIDER_CATALOG } from '@treeseed/sdk/secrets-capability';
import ServiceConnectionWorkspace from '@treeseed/ui/components/astro/service/workspace/ServiceConnectionWorkspace.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { serviceSections } from '../../../lib/services/navigation';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/services')}`);
const context = await loadAppContext(Astro);
const team = context.activeTeam;
const api = new ApiClientFacade(Astro);
const preferences = await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }));
const providerFilter = Astro.url.searchParams.get('provider') ?? '';
const capabilityFilter = Astro.url.searchParams.get('capability') ?? '';
let services: any[] = [];
let vault: any = null;
let unavailable = false;
let vaultUnavailable = false;
const managementRoles = new Set(['team_owner', 'project_lead', 'service_admin']);
const canManage = Boolean(team?.roles?.some((role: string) => managementRoles.has(role)) || team?.currentUserRole && managementRoles.has(team.currentUserRole));
if (team) {
	try {
		services = await api.request<any[]>('GET', `/v1/teams/${encodeURIComponent(team.id)}/services`);
	} catch {
		unavailable = true;
	}
	if (canManage) {
		try {
			vault = await api.request<any>('GET', `/v1/teams/${encodeURIComponent(team.id)}/vault`);
		} catch {
			vaultUnavailable = true;
		}
	}
}
---

<TreeseedAppLayout title="Services" description="Connected provider accounts and reusable hosting capabilities." currentPath="/app/services" teams={context.teams} activeTeam={team} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<ServiceConnectionWorkspace teamName={team ? team.displayName ?? team.name : undefined} {services} providerCatalog={SERVICE_PROVIDER_CATALOG} sections={serviceSections({ current: 'connections' })} {providerFilter} {capabilityFilter} {vault} {unavailable} {vaultUnavailable} {canManage} timeZone={preferences.timeZone} />
</TreeseedAppLayout>
