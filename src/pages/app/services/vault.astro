---
import Badge from '@treeseed/ui/components/astro/data/Badge.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import FormActions from '@treeseed/ui/components/astro/forms/FormActions.astro';
import Field from '@treeseed/ui/components/astro/forms/Field.astro';
import PasswordSetupFields from '@treeseed/ui/components/astro/forms/fields/PasswordSetupFields.astro';
import TextInput from '@treeseed/ui/components/astro/forms/TextInput.astro';
import DisclosureList from '@treeseed/ui/components/astro/data/DisclosureList.astro';
import DataBoundary from '@treeseed/ui/components/astro/patterns/DataBoundary.astro';
import SetupProgress from '@treeseed/ui/components/astro/patterns/SetupProgress.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { serviceSections } from '../../../lib/services/navigation';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/services/vault')}`);
const context = await loadAppContext(Astro);
const team = context.activeTeam;
const canManageVault = Boolean(team?.roles?.includes('team_owner') || team?.currentUserRole === 'team_owner');
const api = new ApiClientFacade(Astro);
const preferences = await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }));
let userVaultKey: any = null;
let vault: any = null;
let grantCandidates: any[] = [];
let vaultEnvelopes: any[] = [];
let unavailable = false;
let forbidden = false;
try {
	userVaultKey = await api.request<any>('GET', '/v1/users/me/vault-key');
	if (team) {
		vault = await api.request<any>('GET', `/v1/teams/${encodeURIComponent(team.id)}/vault`);
		if (vault?.ownGrant && (team?.roles?.includes('team_owner') || team?.currentUserRole === 'team_owner')) {
			[grantCandidates, vaultEnvelopes] = await Promise.all([
				api.request<any[]>('GET', `/v1/teams/${encodeURIComponent(team.id)}/vault/grant-candidates`),
				api.request<any[]>('GET', `/v1/teams/${encodeURIComponent(team.id)}/vault/credential-envelopes`),
			]);
		}
	}
} catch (error) {
	const status = Number((error as { status?: unknown })?.status);
	if (status === 401 || status === 403 || (status === 404 && !canManageVault)) forbidden = true;
	else unavailable = true;
}
const csrfToken = ensureCsrfToken(Astro);
const setupSteps = [
	{
		id: 'personal',
		label: 'Create personal access',
		description: 'Your passphrase protects your administrator key and never leaves this browser.',
		status: userVaultKey ? 'complete' : 'current',
		knowledgePageId: 'vault.personal-key',
	},
	{
		id: 'team',
		label: 'Initialize team custody',
		description: 'A random team key is wrapped separately for each credential administrator.',
		status: vault ? 'complete' : userVaultKey ? 'current' : 'blocked',
		knowledgePageId: 'vault.team-custody',
	},
	{
		id: 'recovery',
		label: 'Review recovery',
		description: 'Know how access is restored—and when credentials must be reentered.',
		status: vault ? 'current' : 'blocked',
		knowledgePageId: 'vault.recovery',
	},
] as const;
---

<TreeseedAppLayout title="Service vault" description="Personal passphrase and team credential access." currentPath="/app/services" teams={context.teams} activeTeam={team} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<SettingsTemplate
		title="Service vault"
		description="Set up personal access, team credential custody, and a recovery plan in a guided sequence."
		sections={serviceSections({ current: 'vault' })}
		class="ts-service-workspace"
		knowledgePageId="vault.overview"
	>
	<section class="ts-stack" data-scene="service.vault">
		{!team ? (
			<EmptyState title="Select an active team" description="Team vault access is scoped to the active team." />
		) : forbidden ? (
			<EmptyState
				title="Vault administration restricted"
				description="Only a team owner can initialize or change vault grants. Service administrators can manage credentials after an owner grants cryptographic access."
			/>
		) : unavailable ? (
			<EmptyState title="Vault unavailable" description="The vault service did not respond.">
				<div slot="actions"><Button href="/app/services/vault" variant="secondary" reload>Retry</Button></div>
			</EmptyState>
		) : (
			<>
				{!canManageVault ? (
					<Panel
						eyebrow="Access boundary"
						title="Team vault lifecycle is owner-managed"
						description="Only a team owner can initialize or change vault grants. Service administrators can manage credentials after an owner grants cryptographic access."
						knowledgePageId="vault.grants"
					/>
				) : null}
				<div class="ts-resource-grid ts-resource-grid--sidebar">
					<SetupProgress
						title="Secure credential setup"
						description="Complete these steps once for this team. Routine credential use happens from each service connection."
						steps={[...setupSteps]}
					/>
					<DataBoundary
						title="Credentials stay under your control"
						description="Secrets are encrypted before they cross the browser boundary."
						stages={[
							{ label: 'In your browser', title: 'Unlock and encrypt', description: 'Your passphrase and plaintext credentials exist only in memory while you approve an action.' },
							{ label: 'In TreeSeed', title: 'Store ciphertext only', description: 'The API keeps encrypted envelopes, access grants, and non-secret audit metadata.' },
							{ label: 'During an operation', title: 'Use once, then discard', description: 'The runner opens one short-lived sealed lease for the approved operation and immediately destroys it.' },
						]}
						protectedLabel="TreeSeed never retains"
						protectedItems={['Passphrases', 'Plaintext provider tokens', 'Derived keys', 'Unlocked private keys']}
					/>
				</div>

				{!userVaultKey ? (
					<Panel eyebrow="Step 1 of 3" title="Create your personal administrator key" description="Choose a unique passphrase. It encrypts your private administrator key locally; it is not your TreeSeed account password." knowledgePageId="vault.personal-key">
						<form class="ts-form-stack" method="post" action="/v1/users/me/vault-key" data-ts-submit="enhanced" data-ts-form-adapter="personal-vault-key" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Personal vault access created." data-scene="service.vault.personal.initialize">
							<input type="hidden" name="csrfToken" value={csrfToken} />
							<PasswordSetupFields passwordId="vaultPassphrase" passwordName="passphrase" confirmName="confirmPassphrase" passwordLabel="Personal vault passphrase" minLength={14} />
							<FormActions align="start"><Button type="submit">Create personal vault key</Button></FormActions>
						</form>
					</Panel>
				) : !vault ? (
					<Panel
						eyebrow="Step 2 of 3"
						title="Initialize team credential custody"
						description="Re-enter the personal vault passphrase you created in step 1. It unlocks your personal administrator key in this browser so a random team vault key can be created and wrapped to you. This does not create a second or shared passphrase."
						knowledgePageId="vault.team-custody"
					>
					<div class="ts-badge-list">
						<Badge tone="success" size="sm">Administrator key ready</Badge>
						<Badge tone="muted" size="sm">Client-encrypted</Badge>
					</div>
					{!canManageVault ? (
						<p>Only a team owner can initialize or change vault grants. Service administrators can manage credentials after an owner grants cryptographic access.</p>
					) : (
						<form class="ts-form-stack" method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/vault`} data-ts-submit="enhanced" data-ts-form-adapter="team-vault-initialize" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Team service vault initialized." data-scene="service.vault.team.initialize">
							<input type="hidden" name="csrfToken" value={csrfToken} />
							<input type="hidden" name="userVaultKeyId" value={userVaultKey.id} />
							<input type="hidden" name="encryptedPrivateKeyEnvelope" value={JSON.stringify(userVaultKey.encryptedPrivateKeyEnvelope)} />
							<Field label="Step 1 personal vault passphrase" name="passphrase" help="Enter the same personal vault passphrase you just created. It stays in this browser and is never sent or stored." knowledgePageId="vault.team-custody" required>
								<TextInput name="passphrase" type="password" autocomplete="current-password" required />
							</Field>
							<FormActions align="start"><Button type="submit">Initialize team vault</Button></FormActions>
						</form>
					)}
					</Panel>
				) : (
					<>
						<Panel eyebrow="Step 3 of 3" title="Team vault active" description="Setup is complete. Review recovery before adding provider credentials." knowledgePageId="vault.recovery">
							<div class="ts-badge-list">
								<Badge tone="success" size="sm">Active</Badge>
								<Badge tone="muted" size="sm">Key version {vault.activeKeyVersion}</Badge>
								<Badge tone={vault.ownGrant ? 'success' : 'warning'} size="sm">{vault.ownGrant ? 'You have access' : 'Grant required'}</Badge>
							</div>
							<p>Initialized <Timestamp value={vault.createdAt} timeZone={preferences.timeZone} />. If every authorized administrator loses access, protected credentials must be reentered.</p>
							<DisclosureList
								title="Recovery and custody rules"
								description="The rules that keep this vault recoverable without weakening encryption."
								itemNoun="rule"
								open
								items={[
									{ label: 'Forgotten passphrase', description: 'Another credential administrator can grant your replacement personal key access.' },
									{ label: 'Sole administrator loss', description: 'Old ciphertext cannot be recovered; reset the vault and reenter protected credentials.' },
									{ label: 'Suspected credential exposure', description: 'Rotate the token at the provider as well as rotating TreeSeed vault access.' },
									{ label: 'Platform access', description: 'TreeSeed support and operators cannot decrypt or recover provider credentials.' },
								]}
							/>
						</Panel>

						<Panel eyebrow="Routine administration" title="Personal access and administrator grants" description="These controls change who can unlock encrypted credentials. They do not reveal credential values." knowledgePageId="vault.grants">
							<div class="ts-badge-list">
								<Badge tone="success" size="sm">Administrator key ready</Badge>
								<Badge tone="muted" size="sm">Personal key version {userVaultKey.version}</Badge>
							</div>
							<details class="ts-permission-checklist">
								<summary>Change personal passphrase</summary>
								<p>This re-encrypts your personal private key. Provider credentials are not decrypted or rewritten.</p>
								<form class="ts-form-stack" method="post" action="/v1/users/me/vault-key" data-ts-submit="enhanced" data-ts-form-adapter="personal-vault-rotate" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Personal vault passphrase changed.">
									<input type="hidden" name="csrfToken" value={csrfToken} />
									<input type="hidden" name="encryptedPrivateKeyEnvelope" value={JSON.stringify(userVaultKey.encryptedPrivateKeyEnvelope)} />
									<Field label="Current passphrase" name="currentPassphrase" required>
										<TextInput name="currentPassphrase" type="password" autocomplete="current-password" required />
									</Field>
									<PasswordSetupFields passwordId="newVaultPassphrase" passwordName="passphrase" confirmName="confirmPassphrase" passwordLabel="New personal vault passphrase" minLength={14} />
									<FormActions align="start"><Button type="submit">Change passphrase</Button></FormActions>
								</form>
							</details>
							<div class="ts-resource-grid">
								{vault.grants.map((grant: any) => (
									<article class="ts-card" data-emphasis="strong">
										<strong>{grant.userId === Astro.locals.auth?.principal?.id ? 'Your administrator grant' : `Administrator ${grant.userId}`}</strong>
										<span>Key version {grant.keyVersion} · {grant.status}</span>
										{canManageVault && vault.ownGrant && grant.status === 'active' && grant.userId !== Astro.locals.auth?.principal?.id ? (
											<form class="ts-form-stack" method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/vault/grants/${encodeURIComponent(grant.id)}`} data-ts-method="DELETE" data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Vault access revoked.">
												<input type="hidden" name="csrfToken" value={csrfToken} />
												<FormActions align="start"><Button type="submit" variant="danger" size="sm">Revoke access</Button></FormActions>
											</form>
										) : null}
									</article>
								))}
							</div>
							{canManageVault && vault.ownGrant && grantCandidates.length ? (
								<details class="ts-permission-checklist">
									<summary>Grant another administrator access</summary>
									<p>The team key is opened and rewrapped only in this browser. The recipient uses a separate personal passphrase.</p>
									{grantCandidates.map((candidate) => (
										<form class="ts-form-stack" method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/vault/grants`} data-ts-submit="enhanced" data-ts-form-adapter="team-vault-grant" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message={`Vault access granted to ${candidate.displayName}.`} data-scene="service.vault.grant">
											<input type="hidden" name="csrfToken" value={csrfToken} />
											<input type="hidden" name="userId" value={candidate.userId} />
											<input type="hidden" name="userVaultKeyId" value={candidate.userVaultKeyId} />
											<input type="hidden" name="recipientPublicKey" value={candidate.publicKey} />
											<input type="hidden" name="wrappedTeamVaultKey" value={vault.ownGrant.wrappedTeamVaultKey} />
											<input type="hidden" name="encryptedPrivateKeyEnvelope" value={JSON.stringify(userVaultKey.encryptedPrivateKeyEnvelope)} />
											<p><strong>{candidate.displayName}</strong> · {candidate.roles.join(', ')}</p>
											<Field label="Your personal vault passphrase" name="passphrase" knowledgePageId="vault.grants" required>
												<TextInput name="passphrase" type="password" autocomplete="current-password" required />
											</Field>
											<FormActions align="start"><Button type="submit" variant="secondary" size="sm">Grant access</Button></FormActions>
										</form>
									))}
								</details>
							) : null}
							{canManageVault && vault.ownGrant ? (
								<details class="ts-permission-checklist">
									<summary>Rotate the team vault key</summary>
									<p>Rewrap every credential key and administrator grant without decrypting or replacing provider credential values.</p>
									<form class="ts-form-stack" method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/vault/rotate`} data-ts-submit="enhanced" data-ts-form-adapter="team-vault-rotate" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Team vault key rotated." data-scene="service.vault.rotate">
										<input type="hidden" name="csrfToken" value={csrfToken} />
										<input type="hidden" name="expectedKeyVersion" value={vault.activeKeyVersion} />
										<input type="hidden" name="wrappedTeamVaultKey" value={vault.ownGrant.wrappedTeamVaultKey} />
										<input type="hidden" name="encryptedPrivateKeyEnvelope" value={JSON.stringify(userVaultKey.encryptedPrivateKeyEnvelope)} />
										<input type="hidden" name="envelopes" value={JSON.stringify(vaultEnvelopes)} />
										<input type="hidden" name="grants" value={JSON.stringify(vault.grants.filter((grant: any) => grant.status === 'active'))} />
										<Field label="Personal vault passphrase" name="passphrase" knowledgePageId="vault.rotation" required>
											<TextInput name="passphrase" type="password" autocomplete="current-password" required />
										</Field>
										<FormActions align="start"><Button type="submit" variant="secondary">Rotate team vault key</Button></FormActions>
									</form>
								</details>
							) : null}
						</Panel>

				{canManageVault ? (
					<Panel eyebrow="Danger zone" title="Reset encrypted credential custody" description="Use this only when every usable vault grant has been lost. All protected provider credentials are permanently discarded and must be reentered." tone="danger" knowledgePageId="vault.reset">
						<form class="ts-form-stack" method="post" action={`/v1/teams/${encodeURIComponent(team.id)}/vault/reset`} data-ts-submit="enhanced" data-ts-form-adapter="team-vault-reset" data-ts-refresh-target='[data-scene="service.vault"]' data-ts-success-message="Vault reset. Reenter every protected provider credential." data-scene="service.vault.reset">
							<input type="hidden" name="csrfToken" value={csrfToken} />
							<input type="hidden" name="userVaultKeyId" value={userVaultKey.id} />
							<input type="hidden" name="encryptedPrivateKeyEnvelope" value={JSON.stringify(userVaultKey.encryptedPrivateKeyEnvelope)} />
							<Field label="Personal vault passphrase" name="passphrase" help="Confirms that this browser can create the replacement grant." knowledgePageId="vault.reset" required>
								<TextInput name="passphrase" type="password" autocomplete="current-password" required />
							</Field>
							<Field label={`Enter RESET ${team.name}`} name="confirmation" required>
								<TextInput name="confirmation" autocomplete="off" required />
							</Field>
							<Field label="Current account password" name="currentPassword" help="Required for recent reauthentication." required>
								<TextInput name="currentPassword" type="password" autocomplete="current-password" required />
							</Field>
							<FormActions align="start"><Button type="submit" variant="danger">Reset vault and discard credentials</Button></FormActions>
						</form>
					</Panel>
				) : null}
					</>
				)}
			</>
		)}
	</section>
	</SettingsTemplate>
</TreeseedAppLayout>

<script>
	import { registerServiceFormAdapters } from '../../../lib/services/form-adapters';
	const dispose = registerServiceFormAdapters();
	document.addEventListener('astro:before-swap', dispose, { once: true });
</script>
