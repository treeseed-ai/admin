---
import { getServiceProviderDefinition } from '@treeseed/sdk/secrets-capability';
import Badge from '@treeseed/ui/components/astro/data/Badge.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import ServiceWizard from '@treeseed/ui/components/astro/service/ServiceWizard.astro';
import ConnectionFields from '@treeseed/ui/components/astro/service/ConnectionFields.astro';
import HelpTrigger from '@treeseed/ui/components/astro/help/HelpTrigger.astro';
import Field from '@treeseed/ui/components/astro/forms/Field.astro';
import TextInput from '@treeseed/ui/components/astro/forms/TextInput.astro';
import CapabilitySelector from '@treeseed/ui/components/astro/service/CapabilitySelector.astro';
import PermissionChecklist from '@treeseed/ui/components/astro/service/PermissionChecklist.astro';
import ProviderAuthorityPanel from '@treeseed/ui/components/astro/service/ProviderAuthorityPanel.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { serviceSections } from '../../../lib/services/navigation';
import { loadServiceItems } from '../../../lib/services/collections';
import { serviceSetup } from '../../../lib/services/setup';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro);
const team = context.activeTeam;
const connectionId = String(Astro.params.connectionId ?? '');
const api = new ApiClientFacade(Astro);
const preferences = await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }));
let connection: any = null;
const credentials: Record<string, any> = {};
let authorities: any[] = [];
let unavailable = false;
let custodyUnavailable = false;
const managementRoles = new Set(['team_owner', 'project_lead', 'service_admin']);
const canManage = Boolean(team?.roles?.some((role: string) => managementRoles.has(role)) || team?.currentUserRole && managementRoles.has(team.currentUserRole));
if (team) {
	try {
		connection = await api.request<any>('GET', `/v1/teams/${encodeURIComponent(team.id)}/services/${encodeURIComponent(connectionId)}`);
	} catch (error) {
		if (Number((error as any)?.status ?? 503) === 404) Astro.response.status = 404;
		else unavailable = true;
	}
	if (connection && canManage) {
		try {
      authorities = await loadServiceItems(api, 'services.credential.authorities.list', { teamId: team.id, connectionId });
      const profiles = getServiceProviderDefinition(connection.providerId)?.credentialProfiles.filter(profile =>
        profile.authoritySchemes?.includes('openbao') && connection.capabilities.some((binding: any) => binding.status === 'configured' && binding.credentialProfileId === profile.id)) ?? [];
      await Promise.all(profiles.map(async profile => {
        credentials[profile.id] = await api.request<any>('GET', `/v1/teams/${encodeURIComponent(team.id)}/services/${encodeURIComponent(connectionId)}/credentials/${encodeURIComponent(profile.id)}`);
      }));
    } catch { custodyUnavailable = true; }
	}
}
const provider = connection ? getServiceProviderDefinition(connection.providerId) : null;
const csrfToken = ensureCsrfToken(Astro);
const connectorConfig = (kind: 'repository' | 'workflow') => connection?.nonSecretConfig?.githubConnectors?.[kind] ?? {};
const authorityStatus = (profileId: string) => authorities.find((item) => item.credentialProfileId === profileId)?.status ?? null;

const {selectedProfiles, taskOptions} = serviceSetup(provider, connection?.capabilities);
const path = team ? '/v1/teams/' + encodeURIComponent(team.id) + '/services/' + encodeURIComponent(connectionId) : '';
const needsAuthentication = selectedProfiles.some(profile => profile.authoritySchemes?.includes('openbao')
  ? !credentials[profile.id]?.configured : authorityStatus(profile.id) !== 'ready');
const profileReady = (profile: typeof selectedProfiles[number]) => profile.authoritySchemes?.includes('openbao') ? Boolean(credentials[profile.id]?.configured) : authorityStatus(profile.id) === 'ready';
const requestedAccess = selectedProfiles.findIndex(profile => profile.id === Astro.url.searchParams.get('access'));
const accessIndex = requestedAccess >= 0 ? requestedAccess : Math.max(0, selectedProfiles.findIndex(profile => !profileReady(profile)));
const initialStep = Astro.url.searchParams.get('step') === 'tasks' || !selectedProfiles.length ? 0
  : needsAuthentication || custodyUnavailable || Astro.url.searchParams.get('access') || Astro.url.searchParams.get('edit') === 'true' ? 2 : 1;
const profileTitle = (id: string, fallback: string) => id === 'github-repository-token' ? 'GitHub repository access'
  : id === 'github-workflow-token' ? 'GitHub Actions access' : id === 'cloudflare-storage' ? 'Cloudflare storage access' : fallback;
---
<TreeseedAppLayout title={connection?.displayName ?? 'Service'} description="Connect your team's services." currentPath="/app/services" teams={context.teams} activeTeam={team} timeZone={preferences.timeZone} contentOwnsPageHeader={Boolean(connection)}>
  {!team ? <EmptyState title="Choose a team first" description="Select the team that owns this connection." />
  : unavailable ? <EmptyState title="Connection could not be loaded" description="Try again in a moment."><div slot="actions"><Button href={Astro.url.pathname} reload>Retry</Button></div></EmptyState>
  : !connection || !provider ? <EmptyState title="Service not found" description="This connection is not available for your team." actions={[{label: 'Back to services', href: '/app/services'}]} />
  : <SettingsTemplate title={connection.displayName} description={provider.label + ' · ' + (team.displayName ?? team.name)} sections={serviceSections({current: 'connections'})} knowledgePageId="services.connection" class="ts-service-workspace">
    <section class="ts-stack" data-scene="service.detail" id="service-workspace">
                <div class="connection-statistics">
                  <table aria-label="Connection statistics">
                    <tbody>
                      <tr><th scope="row">Provider</th><td>{provider.label}</td></tr>
                      <tr><th scope="row">Credentials <HelpTrigger knowledgePageId="services.credentials" label="Help with saved credentials" /></th><td>{custodyUnavailable ? 'Could not check' : needsAuthentication ? 'Setup needed' : 'Saved'}<small>Saved access is not a guarantee that every task has permission.</small></td></tr>
                      <tr><th scope="row">Last changed</th><td><Timestamp value={connection.updatedAt} timeZone={preferences.timeZone} /></td></tr>
                      <tr><th scope="row">Last credential check</th><td>{connection.lastValidatedAt ? <Timestamp value={connection.lastValidatedAt} timeZone={preferences.timeZone} /> : 'No recorded check'}<small>A recorded check, not continuous monitoring.</small></td></tr>
                    </tbody>
                  </table>
                </div>
      {!canManage ? <Panel title="Connection details" knowledgePageId="services.connection">
        {!canManage && <p>Ask a team administrator to change this connection.</p>}
        <CapabilitySelector capabilities={taskOptions} readonly />
      </Panel> : <ServiceWizard {initialStep} existing accountReady={!needsAuthentication && !custodyUnavailable}>
            <form method="post" action={path} class="ts-form-stack" data-ts-method="PUT" data-ts-submit="enhanced" data-ts-form-adapter="service-connection" data-ts-success-message="Settings saved." data-service-settings>
              <input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="providerId" value={provider.id} /><input type="hidden" name="version" value={connection.version} />
              <section data-service-step="0" hidden={initialStep !== 0}><Panel title="Choose your tasks"><div class="ts-form-stack"><p>Choose what your team will use this account for. These tasks determine the access requested in the final step. You can change them later; selecting a task does not deploy anything or grant access by itself.</p><CapabilitySelector capabilities={taskOptions} /></div></Panel></section>
              <section data-service-step="1" hidden={initialStep !== 1}><Panel title="Connection details"><div class="ts-form-stack">

                <p>Update the account details for your team.</p><ConnectionFields {provider} {connection} /></div></Panel></section>
            </form>
        <section data-service-step="2" hidden={initialStep !== 2} id="service-panel-credentials" class="ts-stack" aria-labelledby="service-auth-heading">
          <div><h2 id="service-auth-heading" tabindex="-1">Connect your account <HelpTrigger knowledgePageId="services.credentials" label="Help connecting your account" /></h2>
            <p>{!selectedProfiles.length ? 'Choose at least one task in connection settings to continue.' : custodyUnavailable ? 'Account access could not be checked. Try again in a moment.' : needsAuthentication ? 'Complete the access below for your selected tasks.' : 'Account access is saved. You can check it or replace it below.'}</p>
          </div>
          {custodyUnavailable ? <Button href={Astro.url.pathname} variant="secondary" reload>Retry</Button> : selectedProfiles.filter((_, index) => index === accessIndex).map(profile => {
            if (profile.authoritySchemes?.includes('app-installation') && provider.id === 'github') {
              const kind = profile.id === 'github-repository-app' ? 'repository' : 'workflow';
              return <ProviderAuthorityPanel {kind} teamId={team.id} connectionId={connection.id} csrfToken={csrfToken}
                status={authorityStatus(profile.id)} accountLogin={connectorConfig(kind).accountLogin} installationId={connectorConfig(kind).installationId} permissions={profile.permissions} />;
            }
            const status = credentials[profile.id];
            if (!status) return null;
            const action = path + '/credentials/' + encodeURIComponent(profile.id);
            if (status.configured && Astro.url.searchParams.get('remove') === profile.id) return <Panel title="Remove saved access?" knowledgePageId="services.disconnection">
              <p>Tasks using this access will stop working. The connection itself will remain.</p>
              <form method="post" action={action} data-ts-submit="enhanced" data-ts-form-adapter="managed-credentials" data-ts-method="DELETE" data-service-credentials>
                <input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="expectedVersion" value={status.version} />
                <div class="ts-form-actions"><Button type="submit" variant="danger">Remove saved access</Button><Button href={Astro.url.pathname + '?edit=true&access=' + encodeURIComponent(profile.id)} variant="secondary">Keep access</Button></div>
              </form>
            </Panel>;
            return <Panel title={profileTitle(profile.id, profile.label)} knowledgePageId={provider.knowledgePageIds[0]}>
              <Badge tone={status.configured ? 'muted' : 'warning'}>{status.configured ? 'Access saved' : 'Needs account access'}</Badge>
              <PermissionChecklist permissions={profile.permissions} />

                <form method="post" action={action} class="ts-form-stack" data-ts-submit="enhanced" data-ts-form-adapter="managed-credentials" data-ts-method="PUT" data-ts-success-message="Access details saved." data-service-credentials>
                  <input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="expectedVersion" value={status.version} />
                  {profile.fields.filter(field => field.sensitive).map(field => <Field label={field.label} name={'secret.' + field.key} required={field.required}>
                    <TextInput name={'secret.' + field.key} type="password" autocomplete="off" required={field.required} />
                  </Field>)}
                  <Button type="submit">{status.configured ? 'Replace access details' : 'Save and continue'}</Button>
                </form>
              {status.configured && <div class="ts-form-actions">
                <form method="post" action={action + '/validate'} data-ts-submit="enhanced" data-ts-form-adapter="managed-credentials" data-ts-method="POST" data-ts-success-message="Credential check passed. Individual task permissions may still need review." data-service-credentials>
                  <input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="expectedVersion" value={status.version} />
                  <Button type="submit" variant="secondary">Check access</Button>
                </form>
                <Button href={Astro.url.pathname + '?edit=true&access=' + encodeURIComponent(profile.id) + '&remove=' + encodeURIComponent(profile.id)} variant="ghost">Remove saved access</Button>
              </div>}
            </Panel>;
          })}
          {!custodyUnavailable && selectedProfiles.length > 1 && <nav class="ts-form-actions" aria-label="Account access requests">
            {accessIndex > 0 && <Button href={Astro.url.pathname + '?edit=true&access=' + encodeURIComponent(selectedProfiles[accessIndex - 1].id)} variant="secondary">Previous access request</Button>}
            <span>Account access {accessIndex + 1} of {selectedProfiles.length}</span>
            {accessIndex < selectedProfiles.length - 1 && <Button href={Astro.url.pathname + '?edit=true&access=' + encodeURIComponent(selectedProfiles[accessIndex + 1].id)} variant="secondary">Next access request</Button>}
          </nav>}
        </section>
        <section data-service-step="3" hidden class="ts-stack">
          <Panel title="Disconnect this service" knowledgePageId="services.disconnection"><div class="ts-form-stack">
          <p>This removes this team's connection to {provider.label}. It does not delete your provider account or its resources. Tasks that depend on this connection will lose access; move those tasks to another connection first.</p>
          <p>Project impact is not available here yet. TreeSeed will check dependencies when you disconnect and reject removal while the connection is in use.</p>
          <form method="post" action={path} class="ts-form-stack" data-ts-method="DELETE" data-ts-submit="enhanced" data-ts-form-adapter="service-disconnect" data-ts-success-message="Service disconnected." data-service-disconnect data-connection-name={connection.displayName}>
            <input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="version" value={connection.version} />
            <Field label={'Type “' + connection.displayName + '” to confirm'} name="confirmation" required>
              <TextInput name="confirmation" autocomplete="off" required />
            </Field>
            <Button type="submit" variant="danger">Disconnect</Button>
          </form>
          </div></Panel>
        </section>
      </ServiceWizard>}
    </section>
  </SettingsTemplate>}
</TreeseedAppLayout>
<style>
  .connection-statistics { margin: 1.5rem 0 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--ts-color-border); }
  .connection-statistics table { width: 100%; border-collapse: collapse; text-align: left; }
  .connection-statistics th, .connection-statistics td { padding: .85rem 1rem; border-bottom: 1px solid var(--ts-color-border); vertical-align: top; }
  .connection-statistics th { width: 35%; font-weight: 600; }
  .connection-statistics small { display: block; margin-top: .35rem; color: var(--ts-color-text-muted); }
  @media (max-width: 40rem) { .connection-statistics th, .connection-statistics td { padding: .75rem .4rem; } }
</style>
<script>
  import { initializeServiceForms } from '../../../lib/services/form-lifecycle';
  initializeServiceForms();
</script>
