---
import FeedbackResolutionForm from '@treeseed/ui/components/astro/feedback/management/FeedbackResolutionForm.astro';
import FeedbackStatusBadge from '@treeseed/ui/components/astro/feedback/management/FeedbackStatusBadge.astro';
import FeedbackStatusTimeline from '@treeseed/ui/components/astro/feedback/management/FeedbackStatusTimeline.astro';
import PrivateAttachmentViewer from '@treeseed/ui/components/astro/feedback/management/PrivateAttachmentViewer.astro';
import KeyValueList from '@treeseed/ui/components/astro/data/KeyValueList.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import { principalHasPlatformPermission } from '@treeseed/sdk/api/auth/rbac';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const allowed = principalHasPlatformPermission(Astro.locals.auth.principal, 'feedback:read:global');
const context = await loadAppContext(Astro);
const api = new ApiClientFacade(Astro);
const preferences = await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }));
let feedback: any = null; let unavailable = false;
if (allowed) {
	try { feedback = await api.getFeedback(String(Astro.params.feedbackId ?? '')); }
	catch (error) { if (Number((error as any)?.status) === 404) Astro.response.status = 404; else { unavailable = true; Astro.response.status = 503; } }
} else Astro.response.status = 403;
const csrfToken = ensureCsrfToken(Astro);
---

<TreeseedAppLayout title="Feedback detail" description="Private feedback context and resolution history." currentPath="/app/feedback" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template ts-stack" data-feedback-detail data-scene="feedback.admin.detail">
		{!allowed ? <EmptyState title="Platform administrator access required" description="This private feedback record is restricted." />
		: unavailable ? <EmptyState title="Feedback is temporarily unavailable" description="The feedback record could not be loaded."><div slot="actions"><Button href={Astro.url.pathname} variant="secondary" reload>Retry</Button></div></EmptyState>
		: !feedback ? <EmptyState title="Feedback not found" description="The feedback record does not exist or is no longer available." actions={[{ label: 'Back to feedback', href: '/app/feedback' }]} />
		: <>
			<PageHeader eyebrow={feedback.type.replaceAll('_', ' ')} title={`Feedback ${feedback.id.slice(0, 8)}`} description={feedback.message}><div slot="actions"><FeedbackStatusBadge status={feedback.status} /><Button href="/app/feedback" variant="secondary">Back to feedback</Button></div></PageHeader>
			<div class="ts-resource-grid">
				<Panel title="Verified submission context" description="Identity and authorization were derived by the API, not trusted from the browser.">
					<KeyValueList items={[{ key: 'Submitter', value: feedback.submitter?.displayName ?? feedback.submitterId }, { key: 'Team', value: feedback.team?.displayName ?? feedback.teamId ?? 'Personal scope' }, { key: 'Project', value: feedback.projectId ?? 'None' }, { key: 'Page', value: feedback.canonicalPath }, { key: 'Contact permitted', value: feedback.allowContact ? 'Yes' : 'No' }, ...(feedback.allowContact && feedback.contactEmail ? [{ key: 'Verified contact', value: feedback.contactEmail }] : [])]} />
					<div class="ts-action-bar">{feedback.submitter?.username ? <Button href={`/u/${encodeURIComponent(feedback.submitter.username)}`} variant="secondary">View submitter profile</Button> : null}{feedback.team?.slug ? <Button href={`/t/${encodeURIComponent(feedback.team.slug)}`} variant="secondary">View team profile</Button> : null}</div>
				</Panel>
				<Panel title="Technical context" description="Client details supplied with the report. Expand only when needed.">
					<details><summary>Browser and build details</summary><KeyValueList items={[{ key: 'Environment', value: feedback.context.environment ?? 'Unknown' }, { key: 'Build', value: feedback.context.buildId ?? 'Unknown' }, { key: 'Revision', value: feedback.context.revision ?? 'Unknown' }, { key: 'Browser', value: feedback.client.userAgent ?? 'Unknown' }, { key: 'Viewport', value: `${feedback.client.viewport?.width ?? 0} × ${feedback.client.viewport?.height ?? 0}` }, { key: 'Theme', value: feedback.client.theme ?? 'Unknown' }, { key: 'Locale', value: feedback.client.locale ?? 'Unknown' }, { key: 'Time zone', value: feedback.client.timeZone ?? 'Unknown' }]} /></details>
				</Panel>
			</div>
			{feedback.attachments?.filter((item: any) => !item.expiredAt).map((attachment: any) => <Panel title="Redacted screenshot" description="Private attachment. Download is intentionally not offered."><PrivateAttachmentViewer src={`/v1/admin/feedback/${encodeURIComponent(feedback.id)}/attachments/${encodeURIComponent(attachment.id)}`} digest={attachment.digest} expiresAt={attachment.expiresAt} /></Panel>)}
			<div class="ts-resource-grid">
				<Panel title="Status history" description="Immutable status changes and administrator notes."><FeedbackStatusTimeline events={feedback.history} initialCreatedAt={feedback.createdAt} timeZone={preferences.timeZone} /></Panel>
				<Panel title={feedback.status === 'resolved' ? 'Reopen feedback' : 'Triage and resolve'} description="Resolution and reopening require an administrator note."><FeedbackResolutionForm action={`/v1/admin/feedback/${encodeURIComponent(feedback.id)}/status`} status={feedback.status} version={feedback.version} csrfToken={csrfToken} /></Panel>
			</div>
		</>}
	</section>
</TreeseedAppLayout>
