---
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { loadAppContext } from '../../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const context = await loadAppContext(Astro);
let summary: any = null;
let unavailable = false;
if (context.activeTeam) {
	try {
		summary = await new ApiClientFacade(Astro).request<any>('GET', `/v1/teams/${encodeURIComponent(context.activeTeam.id)}/home`);
	} catch {
		unavailable = true;
		Astro.response.status = 503;
	}
}
const operational = summary?.operational?.catalog;
---

<TreeseedAppLayout
	title="Catalog and billing"
	description="Published catalog and commerce activity for the active team."
	currentPath="/app/market"
	teams={context.teams}
	activeTeam={context.activeTeam}
	contentOwnsPageHeader
>
	<section class="ts-template" aria-label="Catalog and billing" data-scene="domain.overview.catalog">
		<PageHeader eyebrow="Canonical domain" title="Catalog and billing" description="Published catalog and commerce activity for the active team.">
			{context.activeTeam ? <Button slot="actions" href={`/app/teams/${encodeURIComponent(context.activeTeam.id)}`} variant="secondary">Team overview</Button> : null}
		</PageHeader>

		{unavailable ? (
			<EmptyState title="Catalog and billing is temporarily unavailable" description="The team summary service did not respond. No empty state has been inferred.">
				<div slot="actions"><Button href="/app/market" variant="secondary" reload>Retry</Button></div>
			</EmptyState>
		) : !context.activeTeam ? (
			<EmptyState title="Choose an active team" description="Catalog and billing is scoped to an explicitly selected team." actions={[{ label: 'Manage teams', href: '/app/teams' }]} />
		) : (
			<Panel
				eyebrow={context.activeTeam.displayName ?? context.activeTeam.name}
				title={`${operational?.count ?? 0} catalog and billing`}
				description="This bounded landing page preserves domain ownership. Domain-specific mutations remain on their dedicated administration surfaces."
			>
				<p>Operational context loaded for @{context.activeTeam.name}.</p>
			</Panel>
		)}
	</section>
</TreeseedAppLayout>
