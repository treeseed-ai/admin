---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import TreeseedAppLayout from '../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../lib/market/api-client';
import { loadAppContext } from '../../view-models/app-access.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const domains = {
	'/app/projects': { key: 'projects', title: 'Projects', description: 'Project workspaces and their operational state.' },
	'/app/services': { key: 'services', title: 'Services', description: 'Connected provider accounts and capability state.' },
	'/app/work': { key: 'work', title: 'Work', description: 'Team work streams and operational activity.' },
	'/app/capacity': { key: 'capacity', title: 'Capacity and allocation', description: 'Agent capacity available to the active team.' },
	'/app/knowledge': { key: 'knowledge', title: 'Knowledge', description: 'Knowledge activity and review work for the active team.' },
	'/app/market': { key: 'catalog', title: 'Catalog and billing', description: 'Published catalog and commerce activity for the active team.' },
} as const;

const currentPath = Astro.url.pathname.replace(/\/+$/u, '') || '/';
const domain = domains[currentPath as keyof typeof domains] ?? domains['/app/projects'];
const context = await loadAppContext(Astro);
let summary: any = null;
let unavailable = false;
if (context.activeTeam) {
	try {
		summary = await new ApiClientFacade(Astro).request<any>('GET', `/v1/teams/${encodeURIComponent(context.activeTeam.id)}/home`);
	} catch {
		unavailable = true;
		Astro.response.status = 503;
	}
}
const operational = summary?.operational?.[domain.key];
---

<TreeseedAppLayout
	title={domain.title}
	description={domain.description}
	currentPath={currentPath}
	teams={context.teams}
	activeTeam={context.activeTeam}
	contentOwnsPageHeader
>
	<section class="ts-template" aria-label={domain.title} data-scene={`domain.overview.${domain.key}`}>
		<PageHeader eyebrow="Canonical domain" title={domain.title} description={domain.description}>
			{context.activeTeam ? <Button slot="actions" href={`/app/teams/${encodeURIComponent(context.activeTeam.id)}` } variant="secondary">Team overview</Button> : null}
		</PageHeader>

		{unavailable ? (
			<EmptyState title={`${domain.title} is temporarily unavailable`} description="The team summary service did not respond. No empty state has been inferred.">
				<div slot="actions"><Button href={currentPath} variant="secondary" reload>Retry</Button></div>
			</EmptyState>
		) : !context.activeTeam ? (
			<EmptyState title="Choose an active team" description={`${domain.title} is scoped to an explicitly selected team.`} actions={[{ label: 'Manage teams', href: '/app/teams' }]} />
		) : (
			<Panel
				eyebrow={context.activeTeam.displayName ?? context.activeTeam.name}
				title={`${operational?.count ?? 0} ${domain.title.toLowerCase()}`}
				description="This bounded landing page preserves domain ownership. Domain-specific mutations remain on their dedicated administration surfaces."
			>
				<p>Operational context loaded for @{context.activeTeam.name}.</p>
			</Panel>
		)}
	</section>
</TreeseedAppLayout>
