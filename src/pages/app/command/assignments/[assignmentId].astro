---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import KeyValueList from '@treeseed/ui/components/astro/data/KeyValueList.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ModeNavigation from '../../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../../lib/market/api-client.ts';
import { dateValue, items, record, safeReturnTo, text } from '../../../../lib/operations/records.ts';
import { loadAppContext } from '../../../../view-models/app-access.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const assignmentId = String(Astro.params.assignmentId ?? ''); const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro); const team = context.activeTeam;
const base = team ? `/v1/teams/${encodeURIComponent(team.id)}/capacity/assignments/${encodeURIComponent(assignmentId)}` : '';
const [assignmentData, explanationData, runsData, preferences, access] = await Promise.all([team ? api.request('GET', base).catch(() => null) : null, team ? api.request('GET', `${base}/explanation`).catch(() => null) : null, team ? api.request('GET', `/v1/teams/${encodeURIComponent(team.id)}/capacity/execution-runs?assignmentId=${encodeURIComponent(assignmentId)}&limit=100`).catch(() => null) : null, api.accountPreferences().catch(() => ({ timeZone: 'UTC' })), team ? api.getTeamAccessSummary(team.id).catch(() => null) : null]);
const assignment = record(assignmentData); const explanation = record(explanationData); const runs = items(runsData); const csrfToken = ensureCsrfToken(Astro); const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'), '/app/command');
if (team && !assignment.id) Astro.response.status = 404;
const cancelEligible = ['queued', 'leased', 'assigned', 'active'].includes(String(assignment.status ?? assignment.leaseState ?? ''));
const requeueEligible = ['failed', 'cancelled', 'expired', 'returned'].includes(String(assignment.status ?? assignment.leaseState ?? ''));
const canManage = Boolean((access?.roles ?? access?.access?.roles ?? []).some((role: string) => ['team_owner', 'project_lead'].includes(role)));
---
<TreeseedAppLayout title={assignment.id ? `Assignment ${assignment.id}` : 'Assignment unavailable'} description="Matching rationale, execution history, artifacts, usage, and recovery controls." currentPath="/app/command" teams={context.teams} activeTeam={team} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Assignment inspection" data-scene="command.assignment.inspect"><PageHeader eyebrow={`Command · ${String(assignment.status ?? assignment.leaseState ?? 'assignment')}`} title={text(assignment.title, assignment.agentId, assignment.agent_id, 'Assignment unavailable')} description="Inspect the complete control-plane record before taking a recovery action."><Button slot="actions" href={returnTo} variant="secondary">Return to timeline</Button>{assignment.projectId || assignment.project_id ? <Button slot="actions" href={`/app/projects/${encodeURIComponent(String(assignment.projectId ?? assignment.project_id))}`}>Open project</Button> : null}</PageHeader><ModeNavigation mode="command" current="agents" />
		{!team ? <EmptyState title="Choose an active team" description="Assignments are team-scoped." /> : !assignment.id ? <EmptyState title="Assignment not found" description="The assignment is unavailable or outside the active team." /> : <>
			<div class="ts-resource-grid"><Panel eyebrow="Assignment" title="Identity and lease" description="Durable matching and lifecycle state from the API control plane."><KeyValueList items={[{ key: 'Assignment ID', value: String(assignment.id) }, { key: 'Agent', value: text(assignment.agentId, assignment.agent_id, '—') }, { key: 'Class', value: text(assignment.agentClassId, assignment.agent_class_id, '—') }, { key: 'Project', value: text(assignment.projectId, assignment.project_id, '—') }, { key: 'Provider', value: text(assignment.providerId, assignment.provider_id, '—') }, { key: 'Execution provider', value: text(assignment.executionProviderId, assignment.execution_provider_id, '—') }]} />{dateValue(assignment.leaseExpiresAt, assignment.lease_expires_at) ? <p>Lease expires <Timestamp value={dateValue(assignment.leaseExpiresAt, assignment.lease_expires_at)!} timeZone={preferences.timeZone} /></p> : null}</Panel><Panel eyebrow="Assignment function" title="Why this provider was selected" description="The matching explanation is evidence, not an opaque score."><pre class="ts-code-block">{JSON.stringify(explanation, null, 2)}</pre></Panel></div>
			<Panel eyebrow="Execution trace" title={`${runs.length} mode runs`} description="Inputs, outputs, artifacts, diagnostics, timing, usage, and errors remain inspectable.">{runs.map((run) => <details><summary>{text(run.mode, run.handler, 'Mode run')} · {String(run.status ?? 'unknown')}</summary><KeyValueList items={[{ key: 'Run ID', value: String(run.id) }, { key: 'Handler', value: text(run.handler, '—') }, { key: 'Artifacts', value: Array.isArray(run.contentArtifactRefs) ? run.contentArtifactRefs.join(', ') : text(run.contentArtifactRefs, 'None recorded') }, { key: 'Tokens', value: run.tokenCount ?? run.tokens ?? '—' }, { key: 'Duration', value: run.durationMs ? `${run.durationMs} ms` : '—' }]} />{run.id ? <Button href={`/v1/execution-runs/${encodeURIComponent(String(run.id))}/transcript`} variant="secondary" size="sm">Open sanitized transcript</Button> : null}</details>)}</Panel>
			{canManage && (cancelEligible || requeueEligible) ? <Panel eyebrow="Recovery" title="Eligible assignment actions" description="Disruptive actions require a reason and are reauthorized by the API.">{cancelEligible ? <form class="ts-form-stack" method="post" action={`${base}/cancel`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm="Cancel this assignment? Active work may stop." data-ts-refresh-target='[data-scene="command.assignment.inspect"]' data-ts-success-message="Assignment cancelled; the current operational state has been refreshed."><input type="hidden" name="csrfToken" value={csrfToken} /><label class="ts-field"><span class="ts-field__label">Reason</span><input class="ts-control" name="reason" required /></label><Button type="submit" variant="danger">Cancel assignment</Button></form> : null}{requeueEligible ? <form class="ts-form-stack" method="post" action={`${base}/requeue`} data-ts-submit="enhanced" data-ts-form-adapter="json" data-ts-confirm="Requeue this assignment for provider matching?" data-ts-refresh-target='[data-scene="command.assignment.inspect"]' data-ts-success-message="Assignment requeued; provider matching will evaluate it again."><input type="hidden" name="csrfToken" value={csrfToken} /><label class="ts-field"><span class="ts-field__label">Reason</span><input class="ts-control" name="reason" required /></label><Button type="submit">Requeue assignment</Button></form> : null}</Panel> : null}
		</>}
	</section>
</TreeseedAppLayout>
