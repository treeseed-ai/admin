---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import MetricCard from '@treeseed/ui/components/astro/data/metrics/MetricCard.astro';
import MetricGrid from '@treeseed/ui/components/astro/data/metrics/MetricGrid.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ResourceCard from '@treeseed/ui/components/astro/surface/ResourceCard.astro';
import { LiveAgentActivityGantt } from '@treeseed/ui/components/react/OperationsMonitor';
import SituationDeck from '../../../components/command/SituationDeck.astro';
import ModeNavigation from '../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { statusTone, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { activeWorkday, loadCommandSnapshot } from '../../../view-models/command/command-state.ts';
import { deriveCommandSituations } from '../../../view-models/command/situations.ts';
import { loadAgentLabFrame } from '../../../view-models/agent-lab/agent-lab-frame.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const [snapshot, preferences] = await Promise.all([context.activeTeam ? loadCommandSnapshot(api, context.activeTeam.id) : null, api.accountPreferences().catch(() => ({ timeZone: 'UTC', realTimeUpdates: true, realTimePollingIntervalSeconds: 5 as const }))]);
const monitor = context.activeTeam ? await loadAgentLabFrame(api, context.activeTeam, preferences) : null;
const workday = snapshot ? activeWorkday(snapshot) : null; const situations = snapshot ? deriveCommandSituations(snapshot) : [];
const activeAssignments = snapshot?.assignments.filter((item) => ['queued', 'leased', 'running', 'active'].includes(String(item.status ?? item.leaseState ?? ''))) ?? [];
---
<TreeseedAppLayout title="Command" description="Live situational awareness and bounded operational control." currentPath="/app/command" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Command mode" data-scene={workday ? 'command.active-workday' : 'command.no-active-work'}>
		<PageHeader eyebrow="Operations mode" title="Command" description="See material change, understand its consequences, and intervene through authorized controls."><Button slot="actions" href="/app/focus" variant="secondary">Enter Focus</Button></PageHeader>
		<ModeNavigation mode="command" current="overview" />
		{!context.activeTeam ? <EmptyState title="Choose an active team" description="Command is scoped to one team’s operational world." actions={[{ label: 'Manage teams', href: '/app/teams' }]} /> : snapshot ? <>
			<MetricGrid min="12rem"><MetricCard label="Active situations" value={situations.length} description="Conditions needing attention" /><MetricCard label="Current workday" value={workday ? 'Live' : 'Idle'} description={workday ? text(workday.name, workday.scenarioId, 'Execution underway') : 'No run is active'} href={workday ? `/app/work/${encodeURIComponent(String(workday.id))}` : '/app/work'} /><MetricCard label="Assignments in motion" value={activeAssignments.length} description="Queued, leased, or executing" /><MetricCard label="Available providers" value={snapshot.providers.filter((item) => ['active', 'open', 'ready'].includes(String(item.status))).length} description="Reporting current availability" href="/app/capacity" /></MetricGrid>
			<SituationDeck situations={situations} />
			<Panel eyebrow="Live field" title="Agent activity timeline" description="A continuously refreshed view of who is engaging, when, and in which execution mode.">
				{monitor ? <LiveAgentActivityGantt client:load initial={monitor.activity} endpoint={monitor.endpoints.activity} preference={monitor.preference} active={monitor.overview.activeWorkdays > 0} start={monitor.overview.operatingDay.start} end={monitor.overview.operatingDay.end} timeZone={preferences.timeZone} /> : null}
			</Panel>
			<div class="ts-resource-grid"><Panel eyebrow="Operating rhythm" title={workday ? text(workday.name, 'Workday in progress') : 'No active workday'} description={workday ? `Status: ${String(workday.status)}. Open the run to inspect events and legal transitions.` : 'Start from the workday surface when the team is ready to schedule useful work.'}><Button href={workday ? `/app/work/${encodeURIComponent(String(workday.id))}` : '/app/work'}>{workday ? 'Open live workday' : 'Plan a workday'}</Button></Panel><Panel eyebrow="Work queue" title={`${activeAssignments.length} assignments in motion`} description="Open a durable assignment to inspect matching, evidence, artifacts, usage, and recovery options.">{activeAssignments.slice(0, 5).map((item) => <ResourceCard title={text(item.agentId, item.agent_id, 'Agent assignment')} description={text(item.lifecycleReason, item.handler, 'Execution assignment')} status={String(item.status ?? item.leaseState ?? 'queued')} tone={statusTone(item.status)} href={`/app/command/assignments/${encodeURIComponent(String(item.id))}`} />)}</Panel></div>
			{snapshot.unavailable.length ? <p role="status">Some live sources are unavailable: {snapshot.unavailable.join(', ')}. The server snapshot remains visible.</p> : null}
		</> : null}
	</section>
</TreeseedAppLayout>
