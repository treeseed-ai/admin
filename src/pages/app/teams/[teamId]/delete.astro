---
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import ActionList from '@treeseed/ui/components/astro/data/ActionList.astro';
import Badge from '@treeseed/ui/components/astro/data/Badge.astro';
import Countdown from '@treeseed/ui/components/astro/data/Countdown.astro';
import Field from '@treeseed/ui/components/astro/forms/fields/Field.astro';
import FormActions from '@treeseed/ui/components/astro/forms/actions/FormActions.astro';
import TextInput from '@treeseed/ui/components/astro/forms/fields/TextInput.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import { formSubmissionResponse } from '@treeseed/ui/forms';
import TeamNavigation from '../../../../components/team/TeamNavigation.astro';
import TreeseedAppLayout from '../../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../../lib/market/api-client';
import { loadAppContext, resolveAppTeam } from '../../../../view-models/app-access.js';
import { ensureCsrfToken, requireCsrf } from '../../../../lib/auth/support/csrf';

const teamId = String(Astro.params.teamId ?? '');
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

const context = await loadAppContext(Astro);
const resolution = await resolveAppTeam(context, teamId);
const team = resolution.resource;
const access = team ? await context.store.getTeamAccessSummary(team.id, context.principal).catch(() => null) : null;
const isOwner = Boolean(access?.roles?.includes('team_owner'));
const csrfToken = ensureCsrfToken(Astro);
const api = new ApiClientFacade(Astro);
const preferences = await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }));
let readiness: any = null;
let unavailable = resolution.status === 'unavailable';

if (team && isOwner) {
	try {
		readiness = await api.request<any>('GET', `/v1/teams/${encodeURIComponent(team.id)}/deletion-readiness`);
	} catch {
		unavailable = true;
		Astro.response.status = 503;
	}
} else if (!team) Astro.response.status = resolution.status === 'forbidden' ? 403 : resolution.status === 'unavailable' ? 503 : 404;
else Astro.response.status = 403;

if (Astro.request.method === 'POST' && team && isOwner) {
	const data = await Astro.request.formData();
	try {
		requireCsrf(Astro, data.get('csrfToken'));
	} catch {
		return formSubmissionResponse(Astro.request, {
			ok: false, code: 'csrf_invalid', message: 'Your form session expired. Refresh the page and try again.',
		}, { fallbackRedirect: Astro.url.pathname });
	}
	const action = String(data.get('action') ?? '');
	try {
		if (action === 'archive') {
			await api.request('POST', `/v1/teams/${encodeURIComponent(team.id)}/archive`, {
				body: { lifecycleVersion: Number(data.get('lifecycleVersion')) },
			});
			if (context.activeTeam?.id === team.id) Astro.cookies.delete('treeseed_active_team', { path: '/app' });
			return formSubmissionResponse(Astro.request, {
				ok: true, code: 'team_archived', message: 'Team archived.', redirect: '/app/teams',
			}, { fallbackRedirect: '/app/teams' });
		}
		if (action === 'restore') {
			await api.request('POST', `/v1/teams/${encodeURIComponent(team.id)}/restore`, {
				body: { lifecycleVersion: Number(data.get('lifecycleVersion')) },
			});
			return formSubmissionResponse(Astro.request, {
				ok: true, code: 'team_restored', message: 'Team restored.', redirect: `/app/teams/${team.id}`,
			}, { fallbackRedirect: `/app/teams/${team.id}` });
		}
		if (action === 'delete') {
			await api.request('DELETE', `/v1/teams/${encodeURIComponent(team.id)}/permanent-delete`, {
				body: {
					confirmation: String(data.get('confirmation') ?? ''),
					currentPassword: String(data.get('currentPassword') ?? ''),
				},
			});
			if (context.activeTeam?.id === team.id) Astro.cookies.delete('treeseed_active_team', { path: '/app' });
			return formSubmissionResponse(Astro.request, {
				ok: true, code: 'team_deleted', message: 'Team permanently deleted.', redirect: '/app/teams',
			}, { fallbackRedirect: '/app/teams' });
		}
		return formSubmissionResponse(Astro.request, {
			ok: false, code: 'invalid_action', message: 'Choose a valid lifecycle action.',
		}, { fallbackRedirect: Astro.url.pathname });
	} catch (error) {
		const details = (error as any)?.details ?? {};
		return formSubmissionResponse(Astro.request, {
			ok: false,
			code: details.code ?? 'team_lifecycle_failed',
			message: details.message ?? (error instanceof Error ? error.message : 'The lifecycle action failed.'),
			fieldErrors: details.code === 'confirmation'
				? { confirmation: `Type "${team.name}" exactly.` }
				: details.code === 'reauthentication_required'
					? { currentPassword: 'Enter your current password.' }
					: undefined,
		}, { fallbackRedirect: Astro.url.pathname });
	}
}

const blockers = Array.isArray(readiness?.blockers) ? readiness.blockers : [];
const archiveBlockers = Array.isArray(readiness?.archiveBlockers) ? readiness.archiveBlockers : [];
const restoreDeadline = team?.restoreDeadlineAt ? Date.parse(team.restoreDeadlineAt) : Number.NaN;
const restoreAvailable = team?.status === 'archived' && Number.isFinite(restoreDeadline) && restoreDeadline > Date.now();
---

<TreeseedAppLayout title={team ? `${team.displayName ?? team.name} lifecycle` : 'Team unavailable'} description="Archive, restore, or permanently delete a team." currentPath="/app/teams" teams={context.teams} activeTeam={context.activeTeam} contentOwnsPageHeader={Boolean(team)} timeZone={preferences.timeZone}>
	{team ? (
		<>
			<PageHeader eyebrow="Team administration" title="Lifecycle" description={`@${team.name} · Pause team activity, restore access, or permanently delete this team.`} />
			<TeamNavigation team={team} currentPath={Astro.url.pathname} canManage={Boolean(access?.roles?.some((role: string) => ['team_owner', 'project_lead'].includes(role)))} isOwner={isOwner} />
		</>
	) : null}
	{unavailable ? (
		<EmptyState title="Lifecycle checks are unavailable" description="Team lifecycle actions fail closed when blockers cannot be evaluated.">
			<div slot="actions"><Button href={Astro.url.pathname} variant="secondary" reload>Retry</Button></div>
		</EmptyState>
	) : team && isOwner ? (
		<section class="ts-template" aria-label="Team lifecycle" data-scene="team.lifecycle">
			<div class="ts-lifecycle-grid">
				<Panel
					eyebrow="Reversible"
					title={team.status === 'archived' ? 'Team archived' : 'Archive team'}
					description={team.status === 'archived'
						? 'The team is read-only. Restore it before the recovery window ends to resume normal work.'
						: 'Archiving pauses team-scoped changes and removes the team from active selectors without deleting its records.'}
					knowledgePageId="team.lifecycle"
				>
					<div class="ts-lifecycle-summary">
						<div class="ts-lifecycle-summary__status">
							<Badge tone={team.status === 'archived' ? 'warning' : 'success'}>{team.status === 'archived' ? 'Archived' : 'Active'}</Badge>
							<p>{team.status === 'archived' ? 'Team mutations are paused.' : 'Team work remains available.'}</p>
						</div>
						{team.status === 'archived' && team.restoreDeadlineAt ? (
							<Countdown
								target={team.restoreDeadlineAt}
								startedAt={team.archivedAt}
								timeZone={preferences.timeZone}
								label="Restore window"
								completeLabel="Restore window ended"
							/>
						) : null}
						{team.status === 'active' && archiveBlockers.length > 0 ? (
							<ActionList items={archiveBlockers.map((blocker: any) => ({
								title: blocker.label,
								href: blocker.href,
								meta: String(blocker.code).replaceAll('_', ' '),
								tone: 'danger',
							}))} />
						) : team.status === 'active' ? <p>No active archive blockers were found.</p> : null}
						{team.status === 'active' ? (
							<form class="ts-team-form" method="post" action={Astro.url.pathname} data-ts-submit="enhanced" data-ts-success-message="Team archived." data-scene="team.archive">
								<input type="hidden" name="csrfToken" value={csrfToken} />
								<input type="hidden" name="action" value="archive" />
								<input type="hidden" name="lifecycleVersion" value={team.lifecycleVersion} />
								<FormActions align="start"><Button type="submit" variant="secondary" disabled={archiveBlockers.length > 0}>Archive team</Button></FormActions>
							</form>
						) : (
							<form class="ts-team-form" method="post" action={Astro.url.pathname} data-ts-submit="enhanced" data-ts-success-message="Team restored." data-scene="team.restore">
								<input type="hidden" name="csrfToken" value={csrfToken} />
								<input type="hidden" name="action" value="restore" />
								<input type="hidden" name="lifecycleVersion" value={team.lifecycleVersion} />
								<FormActions align="start"><Button type="submit" disabled={!restoreAvailable}>Restore team</Button></FormActions>
								{!restoreAvailable ? <p class="ts-form-help">The restore window has ended. You can still permanently delete this archived team.</p> : null}
							</form>
						)}
					</div>
				</Panel>

				<Panel eyebrow="Irreversible" title="Delete team permanently" description="Deletion is immediate and retains only non-sensitive audit tombstones." tone="danger" knowledgePageId="team.lifecycle">
					<div class="ts-danger-zone">
						<p class="ts-danger-zone__intro">This operation cannot be undone. It is available for active or archived teams after every owned resource and obligation is resolved.</p>
						{blockers.length > 0 ? (
							<ActionList items={blockers.map((blocker: any) => ({
								title: blocker.label,
								href: blocker.href,
								meta: String(blocker.code).replaceAll('_', ' '),
								tone: 'danger',
							}))} />
						) : <p>No deletion blockers were found.</p>}
						<p class="ts-danger-zone__confirmation">To confirm, type <code>{team.name}</code> and enter your current password.</p>
						<form class="ts-team-form" method="post" action={Astro.url.pathname} data-ts-submit="enhanced" data-ts-success-message="Team permanently deleted." data-scene="team.delete">
							<input type="hidden" name="csrfToken" value={csrfToken} />
							<input type="hidden" name="action" value="delete" />
							<Field label={`Type "${team.name}" exactly`} name="confirmation" required>
								<TextInput name="confirmation" required autocomplete="off" />
							</Field>
							<Field label="Current password" name="currentPassword" required>
								<TextInput name="currentPassword" type="password" required autocomplete="current-password" />
							</Field>
							<FormActions align="start">
								<Button type="submit" variant="danger" disabled={!readiness?.ready}>Delete team permanently</Button>
							</FormActions>
							{!readiness?.ready ? <p class="ts-form-help">Resolve every deletion blocker before deleting this team.</p> : null}
						</form>
					</div>
				</Panel>
			</div>
		</section>
	) : team ? (
		<EmptyState title="Owner access required" description="Only team owners can archive, restore, or permanently delete a team." actions={[{ label: 'Team overview', href: `/app/teams/${team.id}` }]} />
	) : (
		<EmptyState title={resolution.status === 'forbidden' ? 'Team access denied' : 'Team not found'} description={resolution.status === 'forbidden' ? 'You do not have access to this team.' : 'This team does not exist.'} actions={[{ label: 'Back to teams', href: '/app/teams' }]} />
	)}
</TreeseedAppLayout>
