---
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import Field from '@treeseed/ui/components/astro/forms/Field.astro';
import FormActions from '@treeseed/ui/components/astro/forms/FormActions.astro';
import TextInput from '@treeseed/ui/components/astro/forms/TextInput.astro';
import Textarea from '@treeseed/ui/components/astro/forms/Textarea.astro';
import Select from '@treeseed/ui/components/astro/forms/Select.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import { formSubmissionResponse } from '@treeseed/ui/forms';
import { CONTROL_PLANE_OPERATIONS } from '@treeseed/sdk/operator-contracts';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../lib/market/api-client';
import { loadAppContext } from '../../../view-models/app-access.js';
import { ensureCsrfToken, requireCsrf } from '../../../lib/auth/support/csrf';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/teams/new')}`);
}

const csrfToken = ensureCsrfToken(Astro);
let formValues = {
	name: '',
	displayName: '',
	logoUrl: '',
	profileSummary: '',
	visibility: 'private',
};

if (Astro.request.method === 'POST') {
	const data = await Astro.request.formData();
	try {
		requireCsrf(Astro, data.get('csrfToken'));
	} catch {
		return formSubmissionResponse(Astro.request, {
			ok: false,
			code: 'csrf_invalid',
			message: 'Your form session expired. Refresh the page and try again.',
		}, { fallbackRedirect: '/app/teams/new' });
	}
	formValues = {
		name: String(data.get('name') ?? '').trim(),
		displayName: String(data.get('displayName') ?? '').trim(),
		logoUrl: String(data.get('logoUrl') ?? '').trim(),
		profileSummary: String(data.get('profileSummary') ?? '').trim(),
		visibility: String(data.get('visibility') ?? 'private'),
	};

	if (!formValues.name) {
		return formSubmissionResponse(Astro.request, {
			ok: false,
			code: 'team_name_required',
			message: 'Please correct the highlighted fields.',
			fieldErrors: { name: 'Name is required.' },
		}, { fallbackRedirect: '/app/teams/new' });
	} else {
		try {
			const team = await new ApiClientFacade(Astro).invoke(CONTROL_PLANE_OPERATIONS.teams.create, {
				path: {}, query: {}, body: { ...formValues, metadata: { visibility: formValues.visibility } },
			});
			return formSubmissionResponse(Astro.request, {
				ok: true,
				code: 'team_created',
				message: 'Team created.',
				redirect: `/app/teams/${team.id}`,
			}, { fallbackRedirect: '/app/teams' });
		} catch (error) {
			const details = (error as any)?.details ?? {};
			const message = details.message ?? (error instanceof Error ? error.message : 'Team could not be created.');
			return formSubmissionResponse(Astro.request, {
				ok: false,
				code: details.code ?? 'team_create_failed',
				message,
				fieldErrors: details.fieldErrors ?? (/(?:name|slug|already exists|taken)/iu.test(message) ? { name: message } : undefined),
			}, { fallbackRedirect: '/app/teams/new' });
		}
	}
}

const context = await loadAppContext(Astro);
---

<TreeseedAppLayout title="New team" description="Create one team." currentPath="/app/teams" teams={context.teams} activeTeam={context.activeTeam} contentOwnsPageHeader>
	<PageHeader eyebrow="Team administration" title="Create a team" description="Start a new team workspace for projects, people, knowledge, and operations.">
		<Button slot="actions" href="/app/teams" variant="secondary">All teams</Button>
	</PageHeader>
	<section class="ts-control-page" aria-label="New team">
		<Panel eyebrow="Identity" title="Team details" description="Choose the identity people will use to find and recognize this team." knowledgePageId="team.creation">
			<form id="team-create-form" class="ts-form-stack ts-team-form" method="POST" action="/app/teams/new" data-ts-submit="enhanced" data-scene="team.create.form">
				<input type="hidden" name="csrfToken" value={csrfToken} />
				<div class="ts-form-grid">
					<Field label="Name" name="name" required>
						<TextInput name="name" required placeholder="acme-ops" pattern="[a-z0-9](?:[a-z0-9\\-]{0,61}[a-z0-9])?" value={formValues.name} />
					</Field>
					<Field label="Display name" name="displayName">
						<TextInput name="displayName" placeholder="Acme Operations" value={formValues.displayName} />
					</Field>
					<Field label="Logo URL" name="logoUrl" class="ts-field--full">
						<TextInput name="logoUrl" type="url" placeholder="https://example.com/logo.svg" value={formValues.logoUrl} />
					</Field>
						<Field label="Profile summary" name="profileSummary" class="ts-field--full">
						<Textarea name="profileSummary" rows={4} placeholder="What this team builds or manages." value={formValues.profileSummary} />
						</Field>
						<Field label="Profile visibility" name="visibility">
							<Select name="visibility" value={formValues.visibility} options={[
								{ label: 'Private', value: 'private' },
								{ label: 'Public identity', value: 'public' },
							]} />
						</Field>
				</div>
				<FormActions align="start">
					<Button type="submit">Create team</Button>
					<Button href="/app/teams" variant="secondary">Cancel</Button>
				</FormActions>
			</form>
		</Panel>
	</section>
</TreeseedAppLayout>
