---
import WorkdayDetailSurface from '@treeseed/ui/components/astro/agent-lab/WorkdayDetailSurface.astro';
import TreeseedAppLayout from '../../../layouts/AppLayout.astro';
import { ensureCsrfToken } from '../../../lib/auth/support/csrf.ts';
import { ApiClientFacade } from '../../../lib/market/api-client.ts';
import { items, record, text } from '../../../lib/operations/records.ts';
import { loadAppContext } from '../../../view-models/app-access.ts';
import { agentLabMetricDestinations, loadAgentLabFrame } from '../../../view-models/agent-lab/agent-lab-frame.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const runId = String(Astro.params.runId ?? ''); const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro); const team = context.activeTeam;
const base = team ? `/v1/teams/${encodeURIComponent(team.id)}` : '';
const [detail, preferences, access] = await Promise.all([team ? api.request('GET', `${base}/workday-runs/${encodeURIComponent(runId)}`).catch(() => null) : null, api.accountPreferences().catch(() => ({ timeZone: 'UTC', realTimeUpdates: true, realTimePollingIntervalSeconds: 5 as const })), team ? api.getTeamAccessSummary(team.id).catch(() => null) : null]);
const payload = record(detail); const run = record(payload.run); const events = items(payload.events); const eventPage = record(payload.eventPage); const csrfToken = ensureCsrfToken(Astro);
const monitor = team ? await loadAgentLabFrame(api, team, preferences, { date: Astro.url.searchParams.get('date'), workday: runId }) : null;
const canManage = Boolean((access?.roles ?? access?.access?.roles ?? []).some((role: string) => ['team_owner', 'project_lead'].includes(role)));
if (team && !run.id) Astro.response.status = 404;
---
<TreeseedAppLayout title={run.id ? text(run.name, run.scenarioId, 'Workday') : 'Workday unavailable'} description="Live workday control and historical execution replay." currentPath="/app/work" teams={context.teams} activeTeam={team} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<WorkdayDetailSurface activeTeam={Boolean(team)} {run} {events} eventTotal={Number(eventPage.total ?? events.length)} eventHasMore={Boolean(eventPage.hasMore)} {monitor} {canManage} {csrfToken} timeZone={preferences.timeZone} transitionAction={`${base}/workday-runs/${encodeURIComponent(runId)}`} metricDestinations={agentLabMetricDestinations} />
</TreeseedAppLayout>
