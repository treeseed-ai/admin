---
import AgentLabEntityPage from '../../../components/agent-lab/AgentLabEntityPage.astro'; import { loadAgentLabEntityPage } from '../../../view-models/agent-lab/entity-page.ts';
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`); const frame = await loadAgentLabEntityPage(Astro, 'assignments');
---
<AgentLabEntityPage frame={frame} label="Assignments" description="Work allocated to agents across every activity profile." />
