---
import type { AgentLabEntityKind } from '@treeseed/sdk/agent-capacity';
import AgentLabEntityPage from '../../../components/agent-lab/AgentLabEntityPage.astro';
import { loadAgentLabEntityPage } from '../../../view-models/agent-lab/entity-page.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const entities: Record<string, { kind: AgentLabEntityKind; label: string; description: string }> = {
	agents: { kind: 'agents', label: 'Agents', description: 'Configured agent classes and their current operating state.' },
	artifacts: { kind: 'artifacts', label: 'Artifacts', description: 'Unique content and evidence generated by team agents.' },
	assignments: { kind: 'assignments', label: 'Assignments', description: 'Work allocated to agents across every activity profile.' },
	events: { kind: 'events', label: 'System Events', description: 'Durable control-plane and runtime transitions from the team’s operating day.' },
	executions: { kind: 'executions', label: 'Executions', description: 'Native execution-provider attempts, outcomes, and live state.' },
};
const entity = entities[Astro.url.pathname.split('/').at(-1) ?? ''];
if (!entity) Astro.response.status = 404;
const frame = entity ? await loadAgentLabEntityPage(Astro, entity.kind) : null;
---
{entity && frame ? <AgentLabEntityPage {frame} label={entity.label} description={entity.description} /> : <p>Agent Lab resource not found.</p>}
