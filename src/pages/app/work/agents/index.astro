---
import AgentLabEntityPage from '../../../../components/agent-lab/AgentLabEntityPage.astro'; import { loadAgentLabEntityPage } from '../../../../view-models/agent-lab/entity-page.ts';
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`); const frame = await loadAgentLabEntityPage(Astro, 'agents');
---
<AgentLabEntityPage frame={frame} label="Agents" description="Configured agent classes and their current operating state." />
