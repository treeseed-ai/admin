---
import AgentLabEntitySurface from '@treeseed/ui/components/astro/agent-lab/AgentLabEntitySurface.astro'; import TreeseedAppLayout from '../../../../layouts/AppLayout.astro'; import { ensureCsrfToken } from '../../../../lib/auth/support/csrf.ts'; import { agentLabMetricDestinations } from '../../../../view-models/agent-lab/agent-lab-frame.ts'; import { loadAgentLabEntityPage } from '../../../../view-models/agent-lab/entity-page.ts';
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`); const frame = await loadAgentLabEntityPage(Astro, 'agents');
---
<TreeseedAppLayout title="Agent Lab · Agents" description="Configured agent classes and their current operating state." currentPath="/app/work" teams={frame.app.teams} activeTeam={frame.app.activeTeam} timeZone={frame.preferences.timeZone} contentOwnsPageHeader><AgentLabEntitySurface activeTeam={Boolean(frame.app.activeTeam)} monitor={frame.monitor} items={frame.items} query={frame.query} status={frame.status} action={Astro.url.pathname} nextHref={frame.nextHref} label="Agents" description="Configured agent classes and their current operating state." csrfToken={ensureCsrfToken(Astro)} metricDestinations={agentLabMetricDestinations} /></TreeseedAppLayout>
