---
import AgentStudioSurface from '@treeseed/ui/components/astro/project/AgentStudioSurface.astro';
import TreeseedAppLayout from '../../../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../../../lib/market/api-client.ts';
import { items, record, text } from '../../../../../lib/operations/records.ts';
import { loadAppContext } from '../../../../../view-models/app-access.ts';
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const projectId = String(Astro.params.projectId ?? ''); const agentId = String(Astro.params.agentId ?? ''); const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const owned = context.activeTeam ? items(await api.listTeamProjects(context.activeTeam.id).catch(() => [])).some((entry) => String(entry.id) === projectId) : false;
const [project, agentData, runsData, fallbackData, auditData, preferences] = owned ? await Promise.all([api.getProjectDetails(projectId).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-classes/${encodeURIComponent(agentId)}`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-mode-runs?limit=100`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-fallback-outputs?limit=100`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/treedx-proxy-audit?limit=100`).catch(() => null), api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))]) : [null, null, null, null, null, await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))];
const belongsToAgent = (entry: Record<string, any>) => String(entry.agentClassId ?? entry.agent_class_id ?? entry.classId ?? '') === agentId;
const agent = record(agentData); const runs = items(runsData).filter(belongsToAgent); const fallbacks = items(fallbackData).filter(belongsToAgent); const audits = items(auditData).filter((entry) => !entry.agentClassId || belongsToAgent(entry)); if (!project || !agent.id) Astro.response.status = 404;
---
<TreeseedAppLayout title={agent.id ? text(agent.displayName, agent.name, 'Agent Studio') : 'Agent unavailable'} description="Read-only class projection, execution history, fallback evidence, and TreeDX access audit." currentPath="/app/projects" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader><AgentStudioSurface {projectId} {agent} {runs} {fallbacks} {audits} timeZone={preferences.timeZone} /></TreeseedAppLayout>
