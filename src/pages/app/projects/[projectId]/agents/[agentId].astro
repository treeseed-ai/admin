---
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import KeyValueList from '@treeseed/ui/components/astro/data/KeyValueList.astro';
import Timestamp from '@treeseed/ui/components/astro/data/Timestamp.astro';
import PageHeader from '@treeseed/ui/components/astro/layout/PageHeader.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ModeNavigation from '../../../../../components/modes/ModeNavigation.astro';
import TreeseedAppLayout from '../../../../../layouts/AppLayout.astro';
import { ApiClientFacade } from '../../../../../lib/market/api-client.ts';
import { dateValue, items, record, text } from '../../../../../lib/operations/records.ts';
import { loadAppContext } from '../../../../../view-models/app-access.ts';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const projectId = String(Astro.params.projectId ?? ''); const agentId = String(Astro.params.agentId ?? ''); const context = await loadAppContext(Astro); const api = new ApiClientFacade(Astro);
const owned = context.activeTeam ? items(await api.listTeamProjects(context.activeTeam.id).catch(() => [])).some((entry) => String(entry.id) === projectId) : false;
const [project, agentData, runsData, fallbackData, auditData, preferences] = owned ? await Promise.all([api.getProjectDetails(projectId).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-classes/${encodeURIComponent(agentId)}`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-mode-runs?limit=100`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/agent-fallback-outputs?limit=100`).catch(() => null), api.request('GET', `/v1/projects/${encodeURIComponent(projectId)}/treedx-proxy-audit?limit=100`).catch(() => null), api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))]) : [null, null, null, null, null, await api.accountPreferences().catch(() => ({ timeZone: 'UTC' }))];
const belongsToAgent = (entry: Record<string, any>) => String(entry.agentClassId ?? entry.agent_class_id ?? entry.classId ?? '') === agentId;
const agent = record(agentData); const runs = items(runsData).filter(belongsToAgent); const fallbacks = items(fallbackData).filter(belongsToAgent); const audits = items(auditData).filter((entry) => !entry.agentClassId || belongsToAgent(entry)); if (!project || !agent.id) Astro.response.status = 404;
---
<TreeseedAppLayout title={agent.id ? text(agent.displayName, agent.name, 'Agent Studio') : 'Agent unavailable'} description="Read-only class projection, execution history, fallback evidence, and TreeDX access audit." currentPath="/app/projects" teams={context.teams} activeTeam={context.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-template" aria-label="Read-only Agent Studio" data-scene="command.agent.studio"><PageHeader eyebrow="Command · Agent Studio" title={text(agent.displayName, agent.name, 'Agent unavailable')} description="Inspect how this configured project role behaves. Authoring remains intentionally outside this surface."><Button slot="actions" href={`/app/projects/${encodeURIComponent(projectId)}/agents`} variant="secondary">Project roster</Button></PageHeader><ModeNavigation mode="command" current="projects" />
		{!agent.id ? <EmptyState title="Agent class not found" description="The synchronized class projection is unavailable or outside your scope." /> : <>
			<div class="ts-resource-grid"><Panel eyebrow="Class projection" title={text(agent.slug, agent.name, String(agent.id))} description={text(agent.description, 'Configured project execution role.')}><KeyValueList items={[{ key: 'Class ID', value: String(agent.id) }, { key: 'Handler', value: text(agent.handler, agent.handlerId, '—') }, { key: 'Activity profile', value: text(agent.activityProfile, agent.activity_profile, '—') }, { key: 'Planning', value: String(agent.planningEnabled ?? agent.planning_enabled ?? 'configured') }, { key: 'Acting', value: String(agent.actingEnabled ?? agent.acting_enabled ?? 'configured') }]} /></Panel><Panel eyebrow="Contract boundary" title="Inspection only" description="Agents, prompts, permissions, handlers, and outputs remain project-owned MDX content synchronized through TreeDX."><p>No authoring control is mounted here.</p></Panel></div>
			<Panel eyebrow="Execution history" title={`${runs.length} mode runs`} description="Each run remains linked to durable assignment and trace evidence.">{runs.map((run) => <details><summary>{text(run.mode, run.handler, 'Mode run')} · {String(run.status ?? 'unknown')}</summary><KeyValueList items={[{ key: 'Assignment', value: text(run.assignmentId, run.providerAssignmentId, '—') }, { key: 'Provider', value: text(run.providerId, run.executionProviderId, '—') }, { key: 'Artifacts', value: Array.isArray(run.contentArtifactRefs) ? run.contentArtifactRefs.join(', ') : 'Inspect assignment' }]} />{dateValue(run.startedAt, run.createdAt) ? <p><Timestamp value={dateValue(run.startedAt, run.createdAt)!} timeZone={preferences.timeZone} /></p> : null}{run.assignmentId || run.providerAssignmentId ? <Button href={`/app/command/assignments/${encodeURIComponent(String(run.assignmentId ?? run.providerAssignmentId))}`} variant="secondary" size="sm">Inspect assignment</Button> : null}</details>)}</Panel>
			<div class="ts-resource-grid"><Panel eyebrow="Fallback outputs" title={`${fallbacks.length} records`} description="Fallbacks are evidence for recovery, never hidden alternate authoring paths."><pre class="ts-code-block">{JSON.stringify(fallbacks.slice(0, 10), null, 2)}</pre></Panel><Panel eyebrow="TreeDX provenance" title={`${audits.length} access records`} description="Content access and mutation remains traceable through the authorized proxy."><pre class="ts-code-block">{JSON.stringify(audits.slice(0, 10), null, 2)}</pre></Panel></div>
		</>}
	</section>
</TreeseedAppLayout>
