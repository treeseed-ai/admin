---
import TreeseedPublicLayout from '../../layouts/PublicLayout.astro';
import KnowledgeActivityTrail from '@treeseed/ui/components/astro/public/profile/KnowledgeActivityTrail.astro';
import KnowledgeProfileCollection from '@treeseed/ui/components/astro/public/profile/KnowledgeProfileCollection.astro';
import KnowledgeProfileIdentity from '@treeseed/ui/components/astro/public/profile/KnowledgeProfileIdentity.astro';
import KnowledgeProfileLayout from '@treeseed/ui/components/astro/public/profile/KnowledgeProfileLayout.astro';
import KnowledgeProfileStats from '@treeseed/ui/components/astro/public/profile/KnowledgeProfileStats.astro';
import TeamNavigation from '../../components/team/TeamNavigation.astro';
import PublicNotFound from '../../components/runtime/PublicNotFound.astro';
import { createApiFacade } from '../../lib/market/api-client';
import { resolvePublicTeamProfile } from '../../lib/market/public-access.js';

export const prerender = false;

const requestedName = String(Astro.params.name ?? '');
const normalizedName = requestedName.trim().toLowerCase().replace(/[^a-z0-9-]+/gu, '-').replace(/^-+|-+$/gu, '').slice(0, 63);
if (requestedName !== normalizedName && normalizedName) return Astro.redirect(`/t/${normalizedName}`, 301);

const profile: any = await resolvePublicTeamProfile(Astro, normalizedName);
if (!profile?.team) Astro.response.status = 404;

const team = profile?.team ?? null;
const knowledge = profile?.knowledge ?? { stats: {}, catalog: [], knowledgePacks: [], projects: [], trail: [] };
const displayName = team?.displayName ?? team?.name ?? 'Team';
const principal = Astro.locals.auth?.principal;
const api = createApiFacade(Astro);
const [preferences, accessibleTeams] = principal
	? await Promise.all([
		api.accountPreferences().catch(() => ({ timeZone: 'UTC' })),
		api.listTeamsForPrincipal().catch(() => []),
	])
	: [{ timeZone: 'UTC' }, []];
const timeZone = preferences.timeZone;
const memberTeam = team ? accessibleTeams.find((entry: any) => entry.name === team.name) ?? null : null;
const memberRoles = memberTeam?.roles ?? [];
const canManageTeam = Boolean(memberTeam?.allowedActions?.edit);
const isOwner = memberRoles.includes('team_owner');
const publishedBySlug = new Map<string, any>();
for (const item of [...(Array.isArray(knowledge.catalog) ? knowledge.catalog : []), ...(Array.isArray(knowledge.knowledgePacks) ? knowledge.knowledgePacks : [])]) {
	const key = `${item.kind ?? 'knowledge_pack'}:${item.slug}`;
	if (!publishedBySlug.has(key)) publishedBySlug.set(key, item);
}
const published = [...publishedBySlug.values()];
const projects = (Array.isArray(knowledge.projects) ? knowledge.projects : []).map((project: any) => ({ ...project, kind: 'project', title: project.name }));
---

{!team ? <PublicNotFound currentPath={Astro.url.pathname} description="This team does not exist or has not published a public profile." /> : <TreeseedPublicLayout
	title={`${displayName} (@${team.name}) | TreeSeed`}
	description={team.profileSummary ?? `Public knowledge profile for @${team.name}.`}
	currentPath={`/t/${team.name}`}
	profilePage
>
	<KnowledgeProfileLayout>
		{memberTeam ? (
			<Fragment slot="navigation">
				<TeamNavigation team={memberTeam} currentPath={Astro.url.pathname} canManage={canManageTeam} isOwner={isOwner} />
			</Fragment>
		) : null}
		<KnowledgeProfileIdentity
			slot="identity"
			kind="team"
			name={displayName}
			handle={team.name}
			imageSrc={team.logoUrl}
			summary={team.profileSummary}
			establishedAt={team.createdAt}
			timeZone={timeZone}
		/>
		<KnowledgeProfileStats slot="stats" items={[
			{ label: 'Templates', value: knowledge.stats.templates ?? 0 },
			{ label: 'Knowledge packs', value: knowledge.stats.knowledgePacks ?? 0 },
			{ label: 'Public projects', value: knowledge.stats.projects ?? 0 },
			{ label: 'Publications', value: knowledge.stats.publications ?? 0 },
		]} />
		<KnowledgeProfileCollection
			eyebrow="Public catalog"
			title="Published knowledge"
			items={published}
			timeZone={timeZone}
		/>
		<KnowledgeProfileCollection
			eyebrow="Public projects"
			title="Public projects"
			items={projects}
			emptyTitle="No public projects yet"
			emptyDescription="Projects remain private until the organization explicitly publishes their identity."
			timeZone={timeZone}
		/>
		<KnowledgeActivityTrail items={knowledge.trail} timeZone={timeZone} />
	</KnowledgeProfileLayout>
</TreeseedPublicLayout>}
