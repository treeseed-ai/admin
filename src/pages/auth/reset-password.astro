---
import AuthShell from '@treeseed/ui/components/astro/auth/AuthShell.astro';
import AuthCard from '@treeseed/ui/components/astro/auth/AuthCard.astro';
import Button from '@treeseed/ui/components/astro/forms/Button.astro';
import FormActions from '@treeseed/ui/components/astro/forms/FormActions.astro';
import PasswordSetupFields from '@treeseed/ui/components/astro/forms/fields/PasswordSetupFields.astro';
import { resolveAnonymousThemePreference } from '../../lib/auth/accounts/appearance';
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/support/flow';
import { passwordMeetsPolicy, passwordPolicyMessage } from '../../lib/auth/accounts/password-policy';
import { createApiFacade } from '../../lib/market/api-client';
import { pageFormFailure, pageFormResponse } from '../../lib/forms/page-submission';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
let token = Astro.url.searchParams.get('token') ?? '';
let error = !token || Astro.url.searchParams.has('error') ? 'This password reset link is invalid or expired.' : '';
const appearance = resolveAnonymousThemePreference(Astro);
const api = createApiFacade(Astro);

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	token = String(form.get('token') ?? '').trim();
	const password = String(form.get('password') ?? '');
	const confirmPassword = String(form.get('confirmPassword') ?? '');
	if (!token) {
		return pageFormFailure(Astro, 'This password reset link is invalid or expired.', Astro.url.pathname + Astro.url.search);
	} else if (!password || !confirmPassword) {
		return pageFormFailure(Astro, 'Please correct the highlighted fields.', Astro.url.pathname + Astro.url.search, {
			...(!password ? { password: 'Password is required.' } : {}),
			...(!confirmPassword ? { confirmPassword: 'Password confirmation is required.' } : {}),
		});
	} else if (password !== confirmPassword) {
		return pageFormFailure(Astro, 'Please correct the highlighted fields.', Astro.url.pathname + Astro.url.search, { confirmPassword: 'Passwords do not match.' });
	} else if (!passwordMeetsPolicy(password)) {
		return pageFormFailure(Astro, 'Please correct the highlighted fields.', Astro.url.pathname + Astro.url.search, { password: passwordPolicyMessage() });
	} else {
		try {
			await api.completePasswordReset(token, password);
			return pageFormResponse(Astro, {
				ok: true,
				code: 'password_reset_complete',
				message: 'Password reset complete.',
				redirect: `/auth/sign-in?reset=complete&returnTo=${encodeURIComponent(returnTo)}`,
			}, Astro.url.pathname + Astro.url.search);
		} catch (resetError) {
			return pageFormFailure(Astro, resetError instanceof Error ? resetError.message : 'Unable to reset password.', Astro.url.pathname + Astro.url.search);
		}
	}
}
---

<AuthShell title="Reset Password | TreeSeed" description="Set a new password for your TreeSeed account." appearance={appearance}>
	<AuthCard
		title={error ? 'Password reset link unavailable' : 'Choose a new password'}
		description={error ? 'Request a new password reset link to continue.' : 'Set a strong password for your TreeSeed account.'}
		error={error}
		appearance={appearance}
	>
		<Fragment slot="sidebarLinks">
			<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Back to sign in</a>
		</Fragment>
		{token && !error ? <form class="auth-form" method="POST" action={`/auth/reset-password?returnTo=${encodeURIComponent(returnTo)}`} data-ts-submit="enhanced">
			<input type="hidden" name="token" value={token} />
			<PasswordSetupFields
				passwordId="resetPassword"
				passwordLabel="New password"
				confirmId="resetPasswordConfirmation"
				confirmLabel="Confirm new password"
			/>
			<FormActions>
				<Button type="submit">Reset password</Button>
			</FormActions>
		</form> : null}
	</AuthCard>
</AuthShell>
