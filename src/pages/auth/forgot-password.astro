---
import AuthShell from '@treeseed/ui/components/astro/auth/AuthShell.astro';
import AuthCard from '@treeseed/ui/components/astro/auth/AuthCard.astro';
import Field from '@treeseed/ui/components/astro/forms/fields/Field.astro';
import TextInput from '@treeseed/ui/components/astro/forms/fields/TextInput.astro';
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import FormActions from '@treeseed/ui/components/astro/forms/actions/FormActions.astro';
import { resolveAnonymousThemePreference } from '../../lib/auth/accounts/appearance';
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/support/flow';
import { createApiFacade } from '../../lib/market/api-client';
import { pageFormFailure, pageFormResponse } from '../../lib/forms/page-submission';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
let error = '';
let submittedEmail = '';
const appearance = resolveAnonymousThemePreference(Astro);
const api = createApiFacade(Astro);

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '').trim();
	submittedEmail = email;
	if (!email) {
		return pageFormFailure(Astro, 'Please correct the highlighted fields.', Astro.url.pathname + Astro.url.search, { email: 'Email is required.' });
	} else {
		try {
			await api.requestPasswordReset(email);
			return pageFormResponse(Astro, {
				ok: true,
				code: 'password_reset_requested',
				message: 'Password reset email sent.',
				redirect: `/auth/check-email?kind=reset&email=${encodeURIComponent(email)}&returnTo=${encodeURIComponent(returnTo)}`,
			}, Astro.url.pathname + Astro.url.search);
		} catch (requestError) {
			return pageFormFailure(Astro, requestError instanceof Error ? requestError.message : 'Password reset could not be requested.', Astro.url.pathname + Astro.url.search);
		}
	}
}
---

<AuthShell title="Forgot Password | TreeSeed" description="Send a password reset link." appearance={appearance}>
	<AuthCard
		title="Reset password"
		description="Enter your account email and we will send a reset link."
		error={error}
		appearance={appearance}
	>
		<Fragment slot="sidebarLinks">
			<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Back to sign in</a>
		</Fragment>
		<form class="auth-form" method="POST" action={`/auth/forgot-password?returnTo=${encodeURIComponent(returnTo)}`} data-ts-submit="enhanced">
			<Field label="Email" name="email" required>
				<TextInput name="email" type="email" autocomplete="email" value={submittedEmail} required />
			</Field>
			<FormActions>
				<Button type="submit">Send reset link</Button>
			</FormActions>
		</form>
	</AuthCard>
</AuthShell>
