---
import AuthShell from '@treeseed/ui/components/astro/auth/AuthShell.astro';
import AuthCard from '@treeseed/ui/components/astro/auth/AuthCard.astro';
import Button from '@treeseed/ui/components/astro/forms/actions/Button.astro';
import FormActions from '@treeseed/ui/components/astro/forms/actions/FormActions.astro';
import { createApiFacade } from '../../lib/market/api-client';
import { resolveAnonymousThemePreference } from '../../lib/auth/accounts/appearance';
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/support/flow';
import { ensureCsrfToken, requireCsrf } from '../../lib/auth/support/csrf';

export const prerender = false;

const returnTo = normalizeReturnTo(Astro);
const token = Astro.url.searchParams.get('token') ?? '';
const appearance = resolveAnonymousThemePreference(Astro);
let error = '';
let confirmed = false;
const api = createApiFacade(Astro);
const csrfToken = ensureCsrfToken(Astro);

if (token && Astro.request.method === 'POST') {
	try {
		const form = await Astro.request.formData();
		requireCsrf(Astro, form.get('csrfToken'));
		await api.confirmEmail(token);
		confirmed = true;
	} catch (confirmationError) {
		error = confirmationError instanceof Error ? confirmationError.message : 'Email confirmation failed.';
	}
} else if (!token) {
	const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
	if (authenticatedRedirect) {
		return authenticatedRedirect;
	}
	error = 'Email confirmation token is missing.';
}
---

<AuthShell title="Confirm Email | TreeSeed" description="Confirm your email to continue." appearance={appearance}>
	<AuthCard
		title={confirmed ? 'Email confirmed' : error ? 'Email confirmation failed' : 'Confirm your email'}
		description={confirmed ? 'Your email is confirmed. Sign in to continue.' : error ? 'The confirmation link is invalid or expired.' : 'Activate this email address once. This link cannot be reused.'}
		error={error}
		appearance={appearance}
	>
		{!confirmed && !error ? <form method="POST"><input type="hidden" name="csrfToken" value={csrfToken} /><FormActions><Button type="submit">Confirm email</Button></FormActions></form> : null}
		{confirmed ? <p><a class="ts-button" href={`/auth/sign-in?verified=1&returnTo=${encodeURIComponent(returnTo)}`}>Sign in</a></p> : null}
		<Fragment slot="sidebarLinks">
			<a href={`/auth/register?returnTo=${encodeURIComponent(returnTo)}`}>Create account</a>
			<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Sign in</a>
		</Fragment>
	</AuthCard>
</AuthShell>
