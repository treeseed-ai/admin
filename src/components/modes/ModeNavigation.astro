---
import SurfaceTabs from '@treeseed/ui/components/astro/shell/navigation/SurfaceTabs.astro';

interface Props { mode: 'focus' | 'command'; current: string }
const { mode, current } = Astro.props as Props;
const items = mode === 'focus' ? [
	{ id: 'overview', label: 'Overview', href: '/app/focus' },
	{ id: 'questions', label: 'Questions', href: '/app/focus/questions' },
	{ id: 'proposals', label: 'Proposals', href: '/app/focus/proposals' },
	{ id: 'decisions', label: 'Decisions', href: '/app/focus/decisions' },
	{ id: 'knowledge', label: 'Knowledge', href: '/app/knowledge' },
] : [
	{ id: 'overview', label: 'Overview', href: '/app/command' },
	{ id: 'workdays', label: 'Agent Lab', href: '/app/work' },
	{ id: 'capacity', label: 'Capacity', href: '/app/capacity' },
	{ id: 'agents', label: 'Agents', href: '/app/command/agents' },
	{ id: 'projects', label: 'Projects', href: '/app/projects' },
];
---

<div data-scene={`mode.navigation.${mode}`}>
	<SurfaceTabs items={items} current={current} label={`${mode === 'focus' ? 'Focus' : 'Command'} sections`} wrap />
</div>
