---
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import { CommandWorkspace } from '@treeseed/ui/components/react/CommandCenter';
import TreeseedAppLayout from '../../layouts/AppLayout.astro';
import type { loadAgentLabCommandPage, AgentLabCommandSurface } from '../../view-models/agent-lab/command-page.ts';
import AgentLabChrome from './AgentLabChrome.astro';
interface Props extends Awaited<ReturnType<typeof loadAgentLabCommandPage>> { current: AgentLabCommandSurface }
const { app, preferences, frame, surface, endpoints, query, current } = Astro.props as Props;
---
<TreeseedAppLayout title={`Agent Lab · ${surface.title}`} description={surface.description} currentPath="/app/work" teams={app.teams} activeTeam={app.activeTeam} timeZone={preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-agent-lab-page" data-scene={`agent-lab.${current}`}>
		{frame && endpoints ? <><AgentLabChrome {frame} {current} inboxCount={surface.unreadCount} /><CommandWorkspace client:load surface={current} initial={surface} {endpoints} realtime={{ enabled: preferences.realTimeUpdates, intervalMs: preferences.realTimePollingIntervalSeconds * 1000 }} timeZone={preferences.timeZone} {query} /></> : <EmptyState title="Choose an active team" description="Agent Lab operations are team-scoped." />}
	</section>
</TreeseedAppLayout>
