---
import EntityCollection from '@treeseed/ui/components/astro/data/entities/EntityCollection.astro';
import OperationsDisplayContainer from '@treeseed/ui/components/astro/operating/navigation/OperationsDisplayContainer.astro';
import EmptyState from '@treeseed/ui/components/astro/surface/EmptyState.astro';
import TreeseedAppLayout from '../../layouts/AppLayout.astro';
import AgentLabChrome from './AgentLabChrome.astro';
import type { loadAgentLabEntityPage } from '../../view-models/agent-lab/entity-page.ts';
interface Props { frame: Awaited<ReturnType<typeof loadAgentLabEntityPage>>; label: string; description: string; }
const { frame, label, description } = Astro.props as Props;
---
<TreeseedAppLayout title={`Agent Lab · ${label}`} description={description} currentPath="/app/work" teams={frame.app.teams} activeTeam={frame.app.activeTeam} timeZone={frame.preferences.timeZone} contentOwnsPageHeader>
	<section class="ts-agent-lab-page" data-scene={`agent-lab.${label.toLowerCase().replaceAll(' ', '-')}`}>
		{frame.monitor ? <AgentLabChrome frame={frame.monitor} /> : null}
		{!frame.app.activeTeam ? <EmptyState title="Choose an active team" description="Agent Lab records are team-scoped." /> : <OperationsDisplayContainer title={label} {description}>
			<EntityCollection items={frame.items} query={frame.query} status={frame.status} action={Astro.url.pathname} emptyTitle={`No ${label.toLowerCase()} found`} nextHref={frame.nextHref} />
		</OperationsDisplayContainer>}
	</section>
</TreeseedAppLayout>
