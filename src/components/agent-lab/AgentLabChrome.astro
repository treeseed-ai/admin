---
import '@treeseed/ui/styles/operations-monitor.css';
import '@treeseed/ui/styles/command-center.css';
import OperationsNavigator from '@treeseed/ui/components/astro/operating/navigation/OperationsNavigator.astro';
import type { loadAgentLabFrame } from '../../view-models/agent-lab/agent-lab-frame.ts';
import AgentLabMonitor from './AgentLabMonitor.astro';

interface Props {
	frame: Awaited<ReturnType<typeof loadAgentLabFrame>>;
	current?: 'inbox' | 'decisions' | 'build' | 'direction' | 'results' | 'find' | '';
	inboxCount?: number;
}

const { frame, current = '', inboxCount = 0 } = Astro.props as Props;
const context = frame.overview.workdayContext;
const selection = new URLSearchParams();
if (context.selectedDate) selection.set('date', context.selectedDate);
if (context.selectedWorkdayId) selection.set('workday', context.selectedWorkdayId);
const selectedSuffix = selection.size ? `?${selection}` : '';
const tabs = [
	{ id: 'inbox', label: 'Inbox', href: `/app/work/inbox${selectedSuffix}`, count: inboxCount || undefined },
	{ id: 'decisions', label: 'Decisions', href: `/app/work/decisions${selectedSuffix}` },
	{ id: 'build', label: 'Build', href: `/app/work/build${selectedSuffix}` },
	{ id: 'direction', label: 'Direction', href: `/app/work/direction${selectedSuffix}` },
	{ id: 'results', label: 'Results', href: `/app/work/results${selectedSuffix}` },
	{ id: 'find', label: 'Find', href: `/app/work/find${selectedSuffix}` },
];
const currentPath = Astro.url.pathname;
const workdays = context.workdays.map((workday) => {
	const params = new URLSearchParams(Astro.url.searchParams);
	params.delete('cursor');
	params.set('date', context.selectedDate);
	params.set('workday', workday.id);
	return { ...workday, href: `${currentPath}?${params}` };
});
const latestParams = new URLSearchParams(Astro.url.searchParams);
latestParams.delete('date'); latestParams.delete('workday'); latestParams.delete('cursor');
const latestHref = `${currentPath}${latestParams.size ? `?${latestParams}` : ''}`;
---

<div class="ts-agent-lab-chrome" data-ts-agent-lab-chrome>
	<AgentLabMonitor frame={frame} />
	<OperationsNavigator
		items={tabs}
		{current}
		selectedDate={context.selectedDate}
		selectedWorkdayId={context.selectedWorkdayId}
		{workdays}
		{latestHref}
	/>
</div>
