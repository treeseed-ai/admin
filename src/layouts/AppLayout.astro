---
import '@treeseed/ui/styles/tokens.css';
import '@treeseed/ui/styles/theme.css';
import '@treeseed/ui/styles/ui.css';
import '@treeseed/ui/styles/forms.css';
import '@treeseed/ui/styles/app-shell.css';
import '@treeseed/ui/styles/app-controls.css';
import '@treeseed/ui/styles/account/forms.css';
import '@treeseed/ui/styles/auth.css';
import ProductShell from '@treeseed/ui/components/astro/shell/layout/ProductShell.astro';
import ShellIcon from '@treeseed/ui/components/astro/shell/navigation/ShellIcon.astro';
import { resolveAuthenticatedThemePreference } from '../lib/auth/accounts/appearance';
import { compileGuidedThemePalette } from '@treeseed/ui/theme';
import { SITE_SLOGAN } from '@treeseed/ui/site-brand';
import { createApiFacade } from '../lib/market/api-client';
import { ensureCsrfToken } from '../lib/auth/support/csrf';

interface TeamEntry {
	id: string;
	name: string;
	slug?: string;
	displayName?: string | null;
}

interface Props {
	title: string;
	description?: string;
	currentPath: string;
	teams: TeamEntry[];
	activeTeam?: TeamEntry | null;
	contentOwnsPageHeader?: boolean;
	timeZone?: string;
}

const {
	title,
	description = 'Manage your account, teams, and active team.',
	currentPath,
	teams,
	activeTeam = null,
	contentOwnsPageHeader = false,
	timeZone: suppliedTimeZone,
} = Astro.props as Props;

const appearance = await resolveAuthenticatedThemePreference(Astro);
const api = createApiFacade(Astro);
const [personalThemes, preferences] = await Promise.all([
	api.personalThemes().catch(() => []),
	suppliedTimeZone ? Promise.resolve({ timeZone: suppliedTimeZone }) : api.accountPreferences().catch(() => ({ timeZone: 'UTC' })),
]);
const customSchemes = Object.fromEntries(personalThemes.flatMap((theme) => {
	try { return [[theme.schemeId, compileGuidedThemePalette(theme.palette, theme.baseScheme)]]; } catch { return []; }
}));
const themeConfig = {
	schemes: customSchemes,
	schemeNames: Object.fromEntries(personalThemes.map((theme) => [theme.schemeId, theme.name])),
};
const csrfToken = ensureCsrfToken(Astro);
const teamOptions = teams.map((team) => ({
	id: team.id,
	label: team.displayName ?? team.name ?? team.slug ?? team.id,
}));
---

<ProductShell
	title={title}
	description={description}
	currentPath={currentPath}
	appearance={appearance}
	contentOwnsPageHeader={contentOwnsPageHeader}
	themeConfig={themeConfig}
	timeZone={preferences.timeZone}
	brand={{
		name: 'TreeSeed',
		tag: SITE_SLOGAN,
		href: '/app/',
		logoSrc: '/logo.svg',
		logoAlt: '',
	}}
	navItems={[
		{ label: 'Start', href: '/app/', icon: 'start' },
	]}
	siteItems={[{ label: 'Home', href: '/' }]}
	quickActions={[
		activeTeam
			? { label: 'Manage team', href: `/app/teams/${encodeURIComponent(activeTeam.id)}/edit`, variant: 'primary' as const, icon: 'team-settings' as const }
			: { label: 'Create team', href: '/app/teams/new', variant: 'primary' as const, icon: 'create' as const },
	]}
	accountActions={[
		{ label: 'Account', href: '/app/account', variant: 'secondary' as const, icon: 'account' as const },
		{ label: 'Sign out', action: '/auth/logout', method: 'post' as const, hiddenFields: { csrfToken }, variant: 'secondary' as const, icon: 'sign-out' as const, iconOnly: true },
	]}
>
	<div slot="railContext" class="ts-team-switcher" data-active-team-label={activeTeam ? (activeTeam.displayName ?? activeTeam.name ?? activeTeam.slug ?? activeTeam.id) : ''}>
		<div class="ts-section__eyebrow">Active team</div>
		{teams.length > 0 ? (
			<form class="ts-team-selector" aria-label="Active team" data-team-switcher>
				<label class="ts-field ts-team-selector__label">
					<select class="ts-control" name="teamId" aria-label="Active team">
						{teamOptions.map((team) => (
							<option value={team.id} selected={team.id === activeTeam?.id}>{team.label}</option>
						))}
					</select>
				</label>
				<a class="ts-icon-button ts-team-manage-button" href="/app/teams" title="Manage teams" aria-label="Manage teams">
					<ShellIcon name="teams" />
				</a>
			</form>
		) : (
			<a class="ts-create-team-button" href="/app/teams/new" title="Create team" aria-label="Create team">
				<ShellIcon name="create" />
				<span class="ts-team-operations__label">Create team</span>
			</a>
		)}
	</div>
	<slot />
</ProductShell>

<script>
	document.querySelectorAll('[data-team-switcher]').forEach((form) => {
		const select = (form as HTMLFormElement).elements.namedItem('teamId') as HTMLSelectElement | null;
		select?.addEventListener('change', () => {
			const url = new URL(window.location.href);
			url.searchParams.delete('teamId');
			document.cookie = `treeseed_active_team=${encodeURIComponent(select.value)}; path=/app; max-age=31536000; SameSite=Lax`;
			window.location.href = url.toString();
		});
	});
</script>

<script>
	import { sendFormRequest } from '@treeseed/ui/forms/client';
	import { shouldReloadAppearancePage } from '../lib/auth/accounts/appearance';

	const bindingKey = '__treeseedAuthenticatedAppearanceSyncBound';
	const syncWindow = window as unknown as Record<string, unknown>;
	if (!syncWindow[bindingKey]) {
		syncWindow[bindingKey] = true;
		window.addEventListener('treeseed:theme-change', (event) => {
			const detail = (event as CustomEvent).detail || {};
			if (detail.persist !== true || !detail.scheme || !detail.mode) return;
			void sendFormRequest({
				url: '/v1/auth/web/appearance',
				init: {
					method: 'PATCH',
					headers: { accept: 'application/json', 'content-type': 'application/json', 'x-treeseed-csrf': document.cookie.split('; ').find((entry) => entry.startsWith('ts_csrf='))?.split('=').slice(1).join('=') || '' },
					body: JSON.stringify({ colorScheme: detail.scheme, themeMode: detail.mode }),
					keepalive: true,
				},
			}).then((response) => {
				if (shouldReloadAppearancePage(window.location.pathname, response.ok)) window.location.reload();
			}).catch(() => {});
		});
	}
</script>
